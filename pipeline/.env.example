# Local secrets and settings for the pipeline. Never commit this file (pipeline/.env is git-ignored).
# Set secrets with `python3 kit/setkey.py NAME` after copying them in the browser (kit/ACCOUNTS.md).
# A line stays commented out until it's set.

# Your email: sent to Wikimedia and the other archives in the User-Agent, as their API rules ask.
# YTC_CONTACT=
# The Chrome profile directory `ytc auth` opens (Default, Profile 2, ...): the one with your personal account.
# YTC_CHROME_PROFILE=
# Buffer: publish.buffer.com/settings/api, Personal Access, + New Key, 1-year expiry.
# BUFFER_API_KEY=
# Buffer's id for the YouTube channel: `uv run --no-sync ytc channels` lists it.
# BUFFER_YOUTUBE_CHANNEL_ID=
# Cloudinary: console.cloudinary.com, API Keys, "API environment variable" (cloudinary://...).
# Optional cross-posting: Buffer's ids for a TikTok and an Instagram (professional) channel connected in Buffer
# (`uv run --no-sync ytc channels` lists them). Each Short scheduled on YouTube goes to them too; off unless set.
# BUFFER_TIKTOK_CHANNEL_ID=
# BUFFER_INSTAGRAM_CHANNEL_ID=
# CLOUDINARY_URL=
# Modal: `uv run --no-sync modal token new`, then `python3 kit/setkey.py --modal`.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# Modal's monthly credit in dollars: 1 on the Starter plan, 30 with a card on file (spend limit $0).
YTC_MODAL_CREDIT=1
# Google AI Studio (aistudio.google.com/apikey), in the channel's Google Cloud project, without billing.
# YTC_GEMINI_API_KEY=
# Optional backup models, on free plans (kit/ACCOUNTS.md, step 9).
# YTC_MISTRAL_API_KEY=
# YTC_OPENROUTER_API_KEY=
# Optional last resort: a key from a personal Cursor account, not a company seat.
# YTC_CURSOR_API_KEY=
# pipeline/modal_secret.py adds YTC_NTFY_TOPIC, the topic the owner's phone subscribes to.
# Optional stock-video and AI-image providers (visuals.py), unused unless set.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
