{
  "id": "ep018",
  "duration": 49.897,
  "beats": [
    {
      "start": 0.08,
      "end": 5.176,
      "text": "The 2025 dire wolf pups were actually gray wolves with twenty edits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Canis lupus occidentalis.jpg",
        "credit": "Ellie Attebery",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Canis_lupus_occidentalis.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.6,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 2.6,
          "end": 5.167,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.176,
      "end": 11.921,
      "text": "Most people believe scientists successfully resurrected the Ice Age predator using ancient DNA.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dire wolf National Park Service illustration.png",
        "credit": "NPS illustration by Benji Paysnoe",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dire_wolf_National_Park_Service_illustration.png"
      },
      "shots": [
        {
          "start": 5.167,
          "end": 8.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 8.067,
          "end": 11.933,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.921,
      "end": 17.892,
      "text": "The dire wolf species vanished approximately ten thousand to thirteen thousand years ago.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Canis dirus skull and neck.jpg",
        "credit": "James St. John",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Canis_dirus_skull_and_neck.jpg"
      },
      "shots": [
        {
          "start": 11.933,
          "end": 15.1,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.1,
          "end": 17.9,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.892,
      "end": 24.837,
      "text": "Instead of splicing ancient genetic material, researchers rewrote existing cells from modern gray wolves.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Stem Cell Research (0443) (13981985775).jpg",
        "credit": "The U.S. Food and Drug Administration",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Stem_Cell_Research_(0443)_(13981985775).jpg"
      },
      "shots": [
        {
          "start": 17.9,
          "end": 21.6,
          "kind": "cover",
          "motion": "camera"
        },
        {
          "start": 21.6,
          "end": 24.833,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.837,
      "end": 31.257,
      "text": "Biologists made twenty targeted edits across fourteen genes to mimic traits like a wider head.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 24.833,
          "end": 31.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.257,
      "end": 38.127,
      "text": "The modified embryos were implanted into surrogate domestic dogs and delivered via cesarean section.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Hound Puppy Mix",
        "credit": "andreaarden",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/45837907@N04/7108563495"
      },
      "shots": [
        {
          "start": 31.267,
          "end": 38.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 38.127,
      "end": 44.576,
      "text": "Independent experts and the IUCN argue these animals are simply hybrid gray wolves.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "Gray Wolf",
        "credit": "U.S. Fish and Wildlife Service - Midwest Region",
        "license": "CC BY 2.0",
        "url": "https://www.flickr.com/photos/49208525@N08/6545954933"
      },
      "shots": [
        {
          "start": 38.133,
          "end": 44.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 44.576,
      "end": 49.547,
      "text": "The 2025 dire wolf pups were actually gray wolves with twenty edits.",
