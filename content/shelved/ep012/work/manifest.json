{
  "id": "ep012",
  "duration": 45.503,
  "beats": [
    {
      "start": 0.08,
      "end": 4.204,
      "text": "For a full century, the heaviest invertebrate on Earth was a ghost.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Calmarcolossal.jpg",
        "credit": "This illustration was made by Citron\nYou must credit this\u00a0: Citron / CC-BY-SA-3.0",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Calmarcolossal.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.2,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 4.204,
      "end": 11.849,
      "text": "Known mostly from damaged dead specimens and whale scars, the colossal squid had never been seen swimming alive anywhere.",
      "asset": {
        "source": "iNaturalist",
        "title": "Sperm Whale (Physeter macrocephalus)",
        "credit": "(c) Vsevolod Rudyi, some rights reserved (CC BY)",
        "license": "CC BY 4.0",
        "url": "https://www.inaturalist.org/observations/129273061"
      },
      "shots": [
        {
          "start": 4.2,
          "end": 9.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 9.267,
          "end": 11.833,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 11.849,
      "end": 19.744,
      "text": "That incredible dark mystery changed completely on March 9, 2025, near the remote South Sandwich Islands.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Zavodovski Island ISS016.jpg",
        "credit": "NASA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Zavodovski_Island_ISS016.jpg"
      },
      "shots": [
        {
          "start": 11.833,
          "end": 19.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.744,
      "end": 28.014,
      "text": "An international research team using the advanced remotely operated vehicle SuBastian recorded the historic moment.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Falkor (too) vessel.jpg",
        "credit": "Embajada de EEUU en Argentina",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Falkor_(too)_vessel.jpg"
      },
      "shots": [
        {
          "start": 19.733,
          "end": 22.967,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 22.967,
          "end": 28.0,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 28.014,
      "end": 33.984,
      "text": "The camera surprisingly revealed a translucent juvenile measuring about 12 inches long.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Cranchiid.jpg",
        "credit": "Edie Widder",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Cranchiid.jpg"
      },
      "shots": [
        {
          "start": 28.0,
          "end": 34.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.984,
      "end": 38.734,
      "text": "It drifted quietly in the dark blue at a depth of 600 meters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Restoration of Sirius Passet.jpg",
        "credit": "Fossiladder13",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Restoration_of_Sirius_Passet.jpg"
      },
      "shots": [
        {
          "start": 34.0,
          "end": 38.733,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 38.734,
      "end": 45.153,
      "text": "After a full century hidden away as a ghost, the heaviest invertebrate on Earth finally came into focus.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Calmarcolossal.jpg",
        "credit": "This illustration was made by Citron\nYou must credit this\u00a0: Citron / CC-BY-SA-3.0",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Calmarcolossal.jpg"
      },
      "shots": [
        {
          "start": 38.733,
          "end": 45.5,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    }
  ],
