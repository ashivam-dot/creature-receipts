          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.23,
      "end": 22.755,
      "text": "Suddenly, a devastating storm struck the capital.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Brooklyn Museum - Stormy Sky over Landscape with Distant Church - Jean-Michel Cels.jpg",
        "credit": "Jean-Michel Cels",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Brooklyn_Museum_-_Stormy_Sky_over_Landscape_with_Distant_Church_-_Jean-Michel_Cels.jpg"
      },
      "shots": [
        {
          "start": 19.233,
          "end": 22.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.755,
      "end": 25.25,
      "text": "Torrential rains extinguished the flames.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The President's House by George Munger, 1814-1815 - Crop.jpg",
        "credit": "George Munger",
        "license": "Public domain",
