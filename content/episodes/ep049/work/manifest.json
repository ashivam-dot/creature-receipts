          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 12.69,
      "end": 16.085,
      "text": "Major-General Robert Ross ordered the White House torched.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait of Robert Ross.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portrait_of_Robert_Ross.jpg"
