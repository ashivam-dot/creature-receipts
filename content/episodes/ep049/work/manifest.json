        }
      ]
    },
    {
      "start": 8.895,
      "end": 12.69,
      "text": "Attendant Paul Jennings helped save George Washington\u2019s portrait.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait of George Washington LCCN2003680524.jpg",
        "credit": "Popular Graphic Arts",
