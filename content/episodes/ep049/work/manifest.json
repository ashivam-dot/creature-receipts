          "motion": "depth"
        }
      ]
    },
    {
      "start": 16.085,
      "end": 19.23,
      "text": "The Library of Congress burned as the sky darkened.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "George-Munger US-Capitol-1814.jpg",
        "credit": "George Munger",
        "license": "Public domain",
