          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.322,
      "end": 27.792,
      "text": "Torrential rains extinguished the flames before nightfall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "U.S. Capitol after burning by the British LCCN2004662324.tif",
        "credit": "Munger, George, 1781-1825, artist",
