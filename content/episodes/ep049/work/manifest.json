      ]
    },
    {
      "start": 20.447,
      "end": 24.322,
      "text": "Suddenly, a devastating storm struck the burning capital.",
      "asset": {
        "source": "Wellcome Collection",
        "title": "A storm at sea. Engraving.",
        "credit": "Wellcome Collection",
        "license": "CC BY 4.0",
