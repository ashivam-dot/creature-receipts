    },
    {
      "start": 8.25,
      "end": 12.545,
      "text": "While other ships were crushed, the USS Wateree had a flat bottom.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "USS Wateree (1863).jpg",
        "credit": "U.S. Naval Historical Center Photograph. Courtesy of Murray Greene Day.",
