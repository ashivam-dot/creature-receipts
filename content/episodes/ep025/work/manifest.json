{
  "id": "ep025",
  "duration": 32.903,
  "beats": [
    {
      "start": 0.08,
      "end": 5.116,
      "text": "Six survived the R101 crash. Two escaped from inside the burning airship.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101 wreckage.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101_wreckage.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 5.116,
      "end": 11.036,
      "text": "In 1930, R101 left England for India with Britain's Air Minister aboard.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101.jpg",
        "credit": "U.K. Government",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101.jpg"
      },
      "shots": [
        {
          "start": 5.1,
          "end": 11.033,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.036,
      "end": 16.731,
      "text": "After its final refit, it flew just seventeen hours of trials, without a full-speed test.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101-framework.jpg",
        "credit": "no author credited",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:R101-framework.jpg"
      },
      "shots": [
        {
          "start": 11.033,
          "end": 16.733,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.731,
      "end": 20.126,
      "text": "In rain and wind over northern France, it twice dived.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101.jpg",
        "credit": "U.K. Government",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101.jpg"
      },
      "shots": [
        {
          "start": 16.733,
          "end": 20.133,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.126,
      "end": 23.696,
      "text": "It struck the ground, caught fire, and forty-eight people died.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101 wreckage.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101_wreckage.jpg"
      },
      "shots": [
        {
          "start": 20.133,
          "end": 23.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.696,
      "end": 29.341,
      "text": "Four engineers escaped external engine cars. The other two came from inside the hull.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.7,
          "end": 29.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.341,
      "end": 32.553,
      "text": "Exactly what triggered its first dive remains disputed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101.jpg",
        "credit": "U.K. Government",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101.jpg"
      },
      "shots": [
        {
          "start": 29.333,
          "end": 32.9,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    }
  ],
