{
  "id": "ep025",
  "duration": 29.671,
  "beats": [
    {
      "start": 0.08,
      "end": 3.3,
      "text": "A rushed political deadline forced the world's largest airship skyward.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101.jpg",
        "credit": "U.K. Government",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.3,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 3.3,
      "end": 7.5,
      "text": "In October 1930, Britain's R101 departed for India on its maiden voyage.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.3,
          "end": 7.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.5,
      "end": 11.36,
      "text": "To boost lift, designers had hastily sliced in an extra gas cell.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101-framework.jpg",
        "credit": "no author credited",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:R101-framework.jpg"
      },
      "shots": [
        {
          "start": 7.5,
          "end": 11.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.36,
      "end": 15.24,
      "text": "Air Minister Lord [Thomson](/t\u02c8\u0251ms\u02c8\u028cn/) boarded despite storm warnings and missed trials.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Christopher Birdwood Thomson, 1st Baron Thomson, in 1926.jpg",
        "credit": "Bassano Ltd",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Christopher_Birdwood_Thomson,_1st_Baron_Thomson,_in_1926.jpg"
      },
      "shots": [
        {
          "start": 11.367,
          "end": 15.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.24,
      "end": 18.38,
      "text": "Gales over France forced the giant into two steep, fatal dives.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101 wreckage.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101_wreckage.jpg"
      },
      "shots": [
        {
          "start": 15.233,
          "end": 18.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.38,
      "end": 22.32,
      "text": "The hydrogen ignited instantly, killing forty-eight people inside the blazing hull.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.367,
          "end": 22.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.32,
      "end": 25.64,
      "text": "The only survivors were engineers riding in external engine cars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101 wreckage.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101_wreckage.jpg"
      },
      "shots": [
        {
          "start": 22.333,
          "end": 25.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.64,
      "end": 29.321,
      "text": "Yet the empire demanded a triumph, ignoring every warning.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "R101.jpg",
        "credit": "U.K. Government",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:R101.jpg"
      },
      "shots": [
        {
          "start": 25.633,
          "end": 29.667,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    }
  ],
