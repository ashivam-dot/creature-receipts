  "beats": [
    {
      "start": 0.08,
      "end": 5.57,
      "text": "In December 1935, Antoine de Saint-Exup\u00e9ry soared above the Libyan desert.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Antoine de Saint-Euxpery (1920).jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Antoine_de_Saint-Euxpery_(1920).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 5.567,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 5.57,
      "end": 8.69,
      "text": "At midnight, his plane clipped a plateau in the dark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Japy, revenant de Moscou, arrive au Bourget (ao\u00fbt 1936) - btv1b9028137q.jpg",
        "credit": "Agence de presse Meurisse. Agence photographique (commanditaire)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Japy,_revenant_de_Moscou,_arrive_au_Bourget_(ao%C3%BBt_1936)_-_btv1b9028137q.jpg"
      },
      "shots": [
        {
          "start": 5.567,
          "end": 8.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.69,
      "end": 12.04,
      "text": "He and Andr\u00e9 Pr\u00e9vot had only a pint of coffee.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.7,
          "end": 12.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.04,
      "end": 15.385,
      "text": "They wandered for four days through heat and hallucinations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Morocco - Marrakech to Sahara (31053290370).jpg",
        "credit": "Visions of Domino",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Morocco_-_Marrakech_to_Sahara_(31053290370).jpg"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 15.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.385,
      "end": 18.935,
      "text": "A Bedouin traveler saved them with a gift of water.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "BASA-3K-7-350-1-Sahara.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:BASA-3K-7-350-1-Sahara.jpg"
      },
      "shots": [
        {
          "start": 15.4,
          "end": 18.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 18.935,
      "end": 22.13,
      "text": "This miracle inspired the setting of The Little Prince.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Little Prince 2 (61520821).jpeg",
        "credit": "Richard Kardhord\u00f3",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Little_Prince_2_(61520821).jpeg"
      },
      "shots": [
        {
          "start": 18.933,
          "end": 22.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.13,
      "end": 24.715,
      "text": "The pilot had survived the sands where he first soared.",
