          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.486,
      "end": 17.986,
      "text": "A Bedouin traveler found them just as hope faded.",
      "asset": {
        "source": "Wikimedia Commons",
