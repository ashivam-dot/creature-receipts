          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.241,
      "end": 11.316,
      "text": "They survived but had only a pint of coffee.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 8.233,
          "end": 11.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 11.316,
      "end": 14.486,
      "text": "For four days, they walked through heat and hallucinations.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sand dunes, Remote view of Dakhla Oasis 2, Egypt.jpg",
        "credit": "Vyacheslav Argenberg",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Sand_dunes,_Remote_view_of_Dakhla_Oasis_2,_Egypt.jpg"
      },
      "shots": [
        {
          "start": 11.3,
