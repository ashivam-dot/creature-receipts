{
  "id": "ep031",
  "duration": 32.527,
  "beats": [
    {
      "start": 0.08,
      "end": 4.8,
      "text": "Tsutomu Yamaguchi was explaining the Hiroshima blast when the second bomb struck.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.8,
      "end": 8.8,
      "text": "Days earlier, the naval engineer was finishing a business trip in Hiroshima.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Employees of the Mitsubishi Heavy Industries 193707.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Employees_of_the_Mitsubishi_Heavy_Industries_193707.jpg"
      },
      "shots": [
        {
          "start": 4.8,
          "end": 8.8,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.8,
      "end": 13.76,
      "text": "At 8:15 a.m., the first atomic bomb detonated three kilometers away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic bombing of Japan.jpg",
        "credit": "George R. Caron / Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_bombing_of_Japan.jpg"
      },
      "shots": [
        {
          "start": 8.8,
          "end": 12.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.133,
          "end": 13.767,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 13.76,
      "end": 17.7,
      "text": "Yamaguchi survived the heat and fled to the safety of Nagasaki.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "018 Hiroshima-Japan 2008-10.jpg",
        "credit": "RuinDig/Yuki Uchida",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:018_Hiroshima-Japan_2008-10.jpg"
      },
      "shots": [
        {
          "start": 13.767,
          "end": 17.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.7,
      "end": 21.14,
      "text": "Bandaged and shaking, he reported for work on August 9.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Catholic cathedral in Nagasaki HD-SN-99-02902.JPEG",
        "credit": "US Army Corps of Engineers",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Catholic_cathedral_in_Nagasaki_HD-SN-99-02902.JPEG"
      },
      "shots": [
        {
          "start": 17.7,
          "end": 21.133,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 21.14,
      "end": 25.74,
      "text": "His supervisor laughed, asking how one bomb could destroy a city.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Catholic cathedral in Nagasaki HD-SN-99-02902.JPEG",
        "credit": "US Army Corps of Engineers",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Catholic_cathedral_in_Nagasaki_HD-SN-99-02902.JPEG"
      },
      "shots": [
        {
          "start": 21.133,
          "end": 25.733,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 25.74,
      "end": 30.12,
      "text": "Suddenly, the second blast erupted three kilometers from his office.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic Cloud Rises Over Nagasaki, Japan - NARA - 535795.tif",
        "credit": "Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_Cloud_Rises_Over_Nagasaki,_Japan_-_NARA_-_535795.tif"
      },
      "shots": [
        {
          "start": 25.733,
          "end": 30.133,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 30.12,
      "end": 32.177,
      "text": "He was forced to start his story over.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 30.133,
          "end": 32.533,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
