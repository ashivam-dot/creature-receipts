  "beats": [
    {
      "start": 0.08,
      "end": 4.06,
      "text": "Tsutomu Yamaguchi was explaining the Hiroshima blast when the second bomb struck.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic Cloud Rises Over Nagasaki, Japan - NARA - 535795.tif",
        "credit": "Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_Cloud_Rises_Over_Nagasaki,_Japan_-_NARA_-_535795.tif"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.067,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 4.06,
      "end": 7.44,
      "text": "Days earlier, the naval engineer was finishing a business trip in Hiroshima.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.067,
          "end": 7.433,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.44,
      "end": 12.06,
      "text": "At 8:15 a.m., the first atomic bomb detonated three kilometers away.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic bombing of Japan.jpg",
        "credit": "George R. Caron / Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_bombing_of_Japan.jpg"
      },
      "shots": [
        {
          "start": 7.433,
          "end": 10.433,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 10.433,
          "end": 12.067,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 12.06,
      "end": 15.12,
      "text": "Yamaguchi survived the heat and returned home to Nagasaki.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "018 Hiroshima-Japan 2008-10.jpg",
        "credit": "RuinDig/Yuki Uchida",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:018_Hiroshima-Japan_2008-10.jpg"
      },
      "shots": [
        {
          "start": 12.067,
          "end": 15.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.12,
      "end": 17.7,
      "text": "Bandaged and shaking, he reported for work on August 9.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.133,
          "end": 17.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.7,
      "end": 21.28,
      "text": "His supervisor laughed, asking how one bomb could destroy a city.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.7,
          "end": 21.267,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.28,
      "end": 24.98,
      "text": "Suddenly, the second blast erupted three kilometers from his office.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic Cloud Rises Over Nagasaki, Japan - NARA - 535795.tif",
        "credit": "Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_Cloud_Rises_Over_Nagasaki,_Japan_-_NARA_-_535795.tif"
      },
      "shots": [
        {
          "start": 21.267,
          "end": 24.967,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 24.98,
      "end": 27.003,
      "text": "He was forced to start his story over.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Atomic Cloud Rises Over Nagasaki, Japan - NARA - 535795.tif",
        "credit": "Charles Levy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Atomic_Cloud_Rises_Over_Nagasaki,_Japan_-_NARA_-_535795.tif"
      },
      "shots": [
        {
          "start": 24.967,
          "end": 27.367,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    }
