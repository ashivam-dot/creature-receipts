{
  "id": "ep050",
  "duration": 27.104,
  "beats": [
    {
      "start": 0.08,
      "end": 4.047,
      "text": "Ranger Ed Pulaski saved forty men by holding them at gunpoint.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.047,
      "end": 9.367,
      "text": "In 1910, hurricane winds whipped Idaho into a three-million-acre firestorm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aftermath of the 1910 Fires (4929786873).jpg",
        "credit": "Forest Service - Northern Region",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aftermath_of_the_1910_Fires_(4929786873).jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 7.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.167,
          "end": 9.367,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 9.367,
      "end": 13.337,
      "text": "Smoke blinded ships in the Pacific and turned midday into night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fire in Electra, Texas (7223829928).jpg",
        "credit": "SMU Central University Libraries",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Fire_in_Electra,_Texas_(7223829928).jpg"
      },
      "shots": [
        {
          "start": 9.367,
          "end": 13.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.337,
      "end": 17.582,
      "text": "Trapped, Pulaski forced his panicked crew into an abandoned mine tunnel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pulaski Tunnel after 1910 fire.jpg",
        "credit": "United States Forest Service",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pulaski_Tunnel_after_1910_fire.jpg"
      },
      "shots": [
        {
          "start": 13.333,
          "end": 17.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.582,
      "end": 21.827,
      "text": "He drew his pistol, forcing them to stay until the firestorm passed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pulaski Tunnel entrance, 1910.jpg",
        "credit": "United States Forest Service",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pulaski_Tunnel_entrance,_1910.jpg"
      },
      "shots": [
        {
          "start": 17.567,
          "end": 21.833,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.827,
      "end": 26.754,
      "text": "Today, wildland firefighters still honor his legacy with the tool named for him.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.833,
          "end": 27.1,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
