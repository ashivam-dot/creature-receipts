  "beats": [
    {
      "start": 0.08,
      "end": 4.047,
      "text": "Ranger Ed Pulaski saved forty men by holding them at gunpoint.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.047,
      "end": 9.367,
      "text": "In 1910, hurricane winds whipped Idaho into a three-million-acre firestorm.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aftermath of the 1910 Fires (4929786873).jpg",
        "credit": "Forest Service - Northern Region",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aftermath_of_the_1910_Fires_(4929786873).jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 7.167,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 7.167,
          "end": 9.367,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 9.367,
      "end": 13.337,
      "text": "Smoke blinded ships in the Pacific and turned midday into night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Fire in Electra, Texas (7223829928).jpg",
        "credit": "SMU Central University Libraries",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Fire_in_Electra,_Texas_(7223829928).jpg"
      },
      "shots": [
        {
          "start": 9.367,
          "end": 13.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.337,
      "end": 17.582,
      "text": "Trapped, Pulaski forced his panicked crew into an abandoned mine tunnel.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pulaski Tunnel after 1910 fire.jpg",
        "credit": "United States Forest Service",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pulaski_Tunnel_after_1910_fire.jpg"
      },
      "shots": [
        {
          "start": 13.333,
          "end": 17.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.582,
      "end": 21.402,
      "text": "He drew his pistol to prevent them from fleeing into the flames.",
      "asset": {
        "source": "Flickr via Openverse",
        "title": "20210715-FS-Mt Hood-Forest Service Trail crew member in Wilderness along Pacific Crest Trail - 01",
        "credit": "Forest Service Pacific Northwest Region",
        "license": "Public domain",
        "url": "https://www.flickr.com/photos/135886671@N08/51316878232"
      },
      "shots": [
        {
          "start": 17.567,
          "end": 21.4,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.402,
      "end": 26.402,
      "text": "Wildland firefighters still carry the tool named for the ranger who saved forty men.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 21.4,
