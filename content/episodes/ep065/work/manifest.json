            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 7.949,
      "end": 11.593,
      "text": "Some called it critical. The superintendent saw no danger.",
      "asset": {
        "source": "Wikimedia Commons / British Library",
        "title": "Quebec bridge view No 48 (HS85-10-18817), cropped landward-arm detail",
        "credit": "F. E. Cudworth",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Quebec_bridge_view_No_48_(HS85-10-18817).jpg",
        "path": "/root/episode/art/construction-pier-detail.jpg"
      },
      "shots": [
        {
          "start": 7.933,
          "end": 11.6,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 11.593,
      "end": 14.863,
      "text": "On August 29, the unfinished bridge collapsed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "File:Pont de Quebec 1907.jpg",
        "credit": "Neurdein",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pont_de_Quebec_1907.jpg",
        "path": "/root/episode/art/collapse-1907.jpg"
      },
      "shots": [
        {
          "start": 11.6,
          "end": 14.867,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 14.863,
      "end": 18.584,
      "text": "The commission found the lower members were defectively designed.",
      "asset": {
        "source": "Wikimedia Commons / BAnQ",
        "title": "Vestiges du pont de Quebec en 1907",
        "credit": "Fred C. W\u00fcrtele / BAnQ, September 1907",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Vestiges_du_pont_de_Quebec_en_1907.jpg",
        "path": "/root/episode/art/aftermath-wurtele-1907.jpg"
      },
      "shots": [
        {
          "start": 14.867,
          "end": 18.6,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 18.584,
      "end": 22.729,
      "text": "It did not believe the fall preventable after August 27.",
      "asset": {
        "source": "Royal Commission report, Appendix 19 figure 20 / Wikimedia Commons",
        "title": "The wreckage, 1907",
        "credit": "Royal Commission Quebec Bridge Inquiry, 1908",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Quebec_Bridge_Collapse_of_1907.jpg",
        "path": "/root/episode/art/commission-wreckage-1907.jpg"
      },
      "shots": [
        {
          "start": 18.6,
          "end": 22.733,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 22.729,
      "end": 29.428,
      "text": "Seventy-five workers died. Better judgment, the commission said, might have saved lives. The bend had been measured.",
