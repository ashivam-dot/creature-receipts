          ]
        }
      ]
    },
    {
      "start": 4.178,
      "end": 7.949,
      "text": "On August 27, steel member 9-L bent farther.",
      "asset": {
        "source": "Royal Commission report / authored graphic",
        "title": "authored approximate structural schematic from report finding (a) and printed page 86",
        "credit": "Royal Commission on the Quebec Bridge; editorial graphic",
        "license": "Public domain",
        "url": "https://archive.org/download/reportandplansa01schngoog/reportandplansa01schngoog.pdf#page=93",
        "path": "/root/episode/art/lower-chord-schematic.png"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 7.933,
          "kind": "cover",
          "motion": "camera",
          "camera_move": [
            1.0,
