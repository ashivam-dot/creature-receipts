    {
      "start": 5.172,
      "end": 10.492,
      "text": "Designing engineer Peter Szlapka drafted the lower chords with a defective design.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Quebec bridge (HS85-10-18815).jpg",
        "credit": "F. E. Cudworth",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Quebec_bridge_(HS85-10-18815).jpg"
      },
      "shots": [
        {
          "start": 5.167,
          "end": 10.5,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.07,
            1.0,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 10.492,
      "end": 15.162,
      "text": "Consulting engineer Theodore Cooper officially approved these flawed plans.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.5,
          "end": 15.167,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 15.162,
      "end": 18.607,
      "text": "Officials placed complete confidence in Cooper's judgment.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.167,
          "end": 18.6,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 18.607,
      "end": 23.602,
      "text": "But contemporary professional knowledge of steel columns under load was inadequate.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.6,
          "end": 23.6,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 23.602,
      "end": 28.022,
      "text": "By August 27, no action could prevent the structural collapse.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 23.6,
          "end": 28.033,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 28.022,
      "end": 31.291,
      "text": "Yet better judgment could have saved human lives on the site.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Quebec bridge (HS85-10-18815).jpg",
        "credit": "F. E. Cudworth",
