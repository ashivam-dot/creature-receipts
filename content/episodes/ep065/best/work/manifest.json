            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 11.831,
      "end": 15.351,
      "text": "On August 29, the massive steel structure fell.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "File:Pont de Quebec 1907.jpg",
        "credit": "Neurdein",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pont_de_Quebec_1907.jpg",
        "path": "/root/episode/art/collapse-1907.jpg"
      },
      "shots": [
        {
          "start": 11.833,
          "end": 15.367,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 15.351,
      "end": 19.746,
      "text": "A royal commission found the failed lower chords were defectively designed.",
      "asset": {
        "source": "Wikimedia Commons / BAnQ",
        "title": "Vestiges du pont de Quebec en 1907",
        "credit": "Fred C. W\u00fcrtele / BAnQ, September 1907",
        "license": "Public domain (PD-old-70-1923)",
        "url": "https://commons.wikimedia.org/wiki/File:Vestiges_du_pont_de_Quebec_en_1907.jpg",
        "path": "/root/episode/art/aftermath-wurtele-1907.jpg"
      },
      "shots": [
        {
          "start": 15.367,
          "end": 19.733,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 19.746,
      "end": 23.891,
      "text": "It did not believe the bridge could be saved after August 27.",
      "asset": {
        "source": "Royal Commission report / authored graphic",
        "title": "authored graphic with facsimile crop of report printed page 9 findings (i) and (j)",
        "credit": "Royal Commission on the Quebec Bridge; editorial graphic",
        "license": "Public domain (1908 Royal Commission report); authored overlay",
        "url": "https://archive.org/download/reportandplansa01schngoog/reportandplansa01schngoog.pdf#page=16",
        "path": "/root/episode/art/report-judgment.png"
      },
      "shots": [
        {
          "start": 19.733,
          "end": 23.9,
          "kind": "cover",
          "motion": "depth",
          "camera_move": [
            1.04,
