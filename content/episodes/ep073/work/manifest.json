          ]
        }
      ]
    },
    {
      "start": 18.325,
      "end": 22.075,
      "text": "To hide the leaks, the company had simply painted it brown.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.333,
          "end": 22.067,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
