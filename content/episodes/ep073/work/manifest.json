    },
    {
      "start": 5.39,
      "end": 10.435,
      "text": "In 1919, the owners ignored obvious structural cracks to save money.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Alcorub newspaper ad.png",
        "credit": "US Industrial Alcohol Co.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Alcorub_newspaper_ad.png"
      },
      "shots": [
        {
          "start": 5.4,
          "end": 10.433,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
