            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 14.18,
      "end": 18.325,
      "text": "A 35 mile per hour wave killed at least 21 people.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boston 1919 molasses disaster - el train structure.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boston_1919_molasses_disaster_-_el_train_structure.jpg"
      },
      "shots": [
        {
          "start": 14.167,
          "end": 18.333,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
