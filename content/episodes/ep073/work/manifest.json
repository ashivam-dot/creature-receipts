            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 10.435,
      "end": 14.18,
      "text": "On a warm winter day, the structure ruptured in the North End.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boston Elevated Railway after the Molasses Flood, January 1919, from the City of Boston Archives - 9800-018-023.jpg",
        "credit": "Boston Elevated Railway Company",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boston_Elevated_Railway_after_the_Molasses_Flood,_January_1919,_from_the_City_of_Boston_Archives_-_9800-018-023.jpg"
      },
      "shots": [
        {
          "start": 10.433,
          "end": 14.167,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
