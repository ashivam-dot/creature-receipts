{
  "id": "ep047",
  "duration": 27.327,
  "beats": [
    {
      "start": 0.08,
      "end": 3.796,
      "text": "Nearly 200 men at the Alamo faced a blood-red flag.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.796,
      "end": 9.141,
      "text": "In 1836, William Travis answered surrender demands with cannon fire.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William b travis.JPG",
        "credit": "Henry McArdle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_b_travis.JPG"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 9.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.141,
      "end": 13.111,
      "text": "For 13 days, they waited for reinforcements that never came.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Travis letter page 1 adj.jpg",
        "credit": "William Barret Travis (1809 - 1836)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Travis_letter_page_1_adj.jpg"
      },
      "shots": [
        {
          "start": 9.133,
          "end": 13.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.111,
      "end": 16.656,
      "text": "At dawn on March 6, thousands of troops breached the walls.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Travis letter page 1 adj.jpg",
        "credit": "William Barret Travis (1809 - 1836)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Travis_letter_page_1_adj.jpg"
      },
      "shots": [
        {
          "start": 13.1,
          "end": 16.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.656,
      "end": 20.256,
      "text": "The final massacre was over in only 90 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ruins-of-the-church-of-el-alamo-unknown.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ruins-of-the-church-of-el-alamo-unknown.jpg"
      },
      "shots": [
        {
          "start": 16.667,
          "end": 20.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.256,
      "end": 24.206,
      "text": "Six weeks later, the Texian army won in 18 minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sam Houston at San Jacinto.jpg",
        "credit": "Henry Arthur McArdle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sam_Houston_at_San_Jacinto.jpg"
      },
      "shots": [
        {
          "start": 20.267,
          "end": 24.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.206,
      "end": 26.977,
      "text": "They remembered the men who faced that blood-red flag.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 24.2,
          "end": 27.333,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
