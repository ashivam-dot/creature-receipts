  "beats": [
    {
      "start": 0.08,
      "end": 3.796,
      "text": "Nearly 200 men at the Alamo faced a blood-red flag.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.8,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.796,
      "end": 9.141,
      "text": "In 1836, William Travis answered surrender demands with cannon fire.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "William b travis.JPG",
        "credit": "Henry McArdle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:William_b_travis.JPG"
      },
      "shots": [
        {
          "start": 3.8,
          "end": 9.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.141,
      "end": 14.536,
      "text": "Travis pleaded for help. Thirty-two men from Gonzales arrived, but he still needed more.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Travis letter page 1 adj.jpg",
        "credit": "William Barret Travis (1809 - 1836)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Travis_letter_page_1_adj.jpg"
      },
      "shots": [
        {
          "start": 9.133,
          "end": 14.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.536,
      "end": 19.056,
      "text": "At dawn, about 1,800 attackers breached the crumbling walls.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "FalloftheAlamo.jpg",
        "credit": "Robert Jenkins Onderdonk",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:FalloftheAlamo.jpg"
      },
      "shots": [
        {
          "start": 14.533,
          "end": 16.633,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 16.633,
          "end": 19.067,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 19.056,
      "end": 22.531,
      "text": "Within ninety minutes, the final assault was over.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ruins-of-the-church-of-el-alamo-unknown.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ruins-of-the-church-of-el-alamo-unknown.jpg"
      },
      "shots": [
        {
          "start": 19.067,
          "end": 22.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.531,
      "end": 27.881,
      "text": "On April 21, Texian troops won at San Jacinto in under twenty minutes.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Sam Houston at San Jacinto.jpg",
        "credit": "Henry Arthur McArdle",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Sam_Houston_at_San_Jacinto.jpg"
      },
      "shots": [
        {
          "start": 22.533,
          "end": 25.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.133,
          "end": 27.867,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 27.881,
      "end": 30.661,
      "text": "They remembered the men who faced that blood-red flag.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 27.867,
          "end": 31.0,
          "kind": "designed",
          "motion": "camera"
