  "beats": [
    {
      "start": 0.08,
      "end": 4.091,
      "text": "This fish was supposed to be extinct for 66 million years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coelacanth off Pumula on the KwaZulu-Natal South Coast, South Africa, on 22 November 2019.png",
        "credit": "Bruce A.S. Henderson",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Coelacanth_off_Pumula_on_the_KwaZulu-Natal_South_Coast,_South_Africa,_on_22_November_2019.png"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.091,
      "end": 16.211,
      "text": "On December 22, 1938, dedicated museum curator Marjorie Courtenay-Latimer spotted an unfamiliar bright blue fin resting inside a South African fishing catch.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Marjorie Courtenay-Latimer Postcard.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Marjorie_Courtenay-Latimer_Postcard.jpg"
      },
      "shots": [
        {
          "start": 4.1,
          "end": 16.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.211,
      "end": 25.361,
      "text": "Instead of a traditional bony backbone, this remarkable living animal actually possesses a pressurized, oil-filled tube called a notochord.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coelacanth in Kuwait by Prof Dr Norman Ali Khalaf July 2019.jpg",
        "credit": "Jaffacity",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Coelacanth_in_Kuwait_by_Prof_Dr_Norman_Ali_Khalaf_July_2019.jpg"
      },
      "shots": [
        {
          "start": 16.2,
          "end": 25.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.361,
      "end": 35.561,
      "text": "Recent marine biology research reveals these deep-sea survivors endure a staggering five-year pregnancy before finally giving birth to live pups.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Latimeria zoological reconstruction diorama (coelacanth) by Sebastian Brandt (Reco-Brandt).jpg",
        "credit": "TB0815",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Latimeria_zoological_reconstruction_diorama_(coelacanth)_by_Sebastian_Brandt_(Reco-Brandt).jpg"
      },
      "shots": [
        {
          "start": 25.367,
          "end": 35.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.561,
      "end": 43.906,
      "text": "Biologists found this swimming ghost is actually much more closely related to land animals than to 99 percent of other fish.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mawsonia scaling.png",
        "credit": "Lionel Cavin, Andr\u00e9 Piuz, Christophe Ferrante & Guillaume Guinot",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mawsonia_scaling.png"
      },
      "shots": [
        {
          "start": 35.567,
          "end": 43.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 43.906,
      "end": 49.88,
      "text": "Scientists had officially declared this prehistoric creature extinct for 66 million years.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Coelacanth off Pumula on the KwaZulu-Natal South Coast, South Africa, on 22 November 2019.png",
        "credit": "Bruce A.S. Henderson",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Coelacanth_off_Pumula_on_the_KwaZulu-Natal_South_Coast,_South_Africa,_on_22_November_2019.png"
      },
      "shots": [
        {
          "start": 43.9,
          "end": 50.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
