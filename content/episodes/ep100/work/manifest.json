          ]
        }
      ]
    },
    {
      "start": 10.843,
      "end": 14.913,
      "text": "On August twenty-fourth, the Visigoths poured through the Salarian Gate.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Roman Forum (Hansen).jpg",
        "credit": "Constantin Hansen",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Roman_Forum_(Hansen).jpg"
      },
      "shots": [
        {
          "start": 10.833,
          "end": 14.9,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 14.913,
      "end": 18.663,
      "text": "For three days, the conquerors pillaged the ancient capital.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Wilhelm Riedel - Forum Romanum (Roman Ruins) - O 4260 - National Gallery Prague.jpg",
        "credit": "Wilhelm Riedel",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Wilhelm_Riedel_-_Forum_Romanum_(Roman_Ruins)_-_O_4260_-_National_Gallery_Prague.jpg"
      },
      "shots": [
        {
          "start": 14.9,
          "end": 18.667,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 18.663,
      "end": 21.683,
      "text": "Saint Jerome wrote that the world itself was taken.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Domenico ghirlandaio, san girolamo 01.jpg",
        "credit": "Domenico Ghirlandaio",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Domenico_ghirlandaio,_san_girolamo_01.jpg"
      },
      "shots": [
        {
          "start": 18.667,
          "end": 21.667,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
