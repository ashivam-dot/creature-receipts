        "source": "Wikimedia Commons",
        "title": "Consular diptych Probus 406.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Consular_diptych_Probus_406.jpg"
      },
      "shots": [
        {
