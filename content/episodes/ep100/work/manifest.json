          ]
        }
      ]
    },
    {
      "start": 7.223,
      "end": 10.843,
      "text": "Outside the walls, King Alaric tightened a starving blockade.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "02-ALARICO.JPG",
        "credit": "Upload by Basilio",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:02-ALARICO.JPG"
      },
      "shots": [
        {
          "start": 7.233,
          "end": 10.833,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
