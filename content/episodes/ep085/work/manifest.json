          ]
        }
      ]
    },
    {
      "start": 18.737,
      "end": 24.762,
      "text": "Forensic re-examination of forty-six skulls revealed fatal perimortem fractures.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 18.733,
          "end": 24.767,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
