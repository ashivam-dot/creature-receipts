          ]
        }
      ]
    },
    {
      "start": 13.442,
      "end": 18.737,
      "text": "The tombs were sealed simultaneously, suggesting these retainers were sacrificed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Petrie.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Petrie.jpg"
      },
      "shots": [
        {
          "start": 13.433,
          "end": 18.733,
