        }
      ]
    },
    {
      "start": 16.1,
      "end": 20.625,
      "text": "Fetterman reportedly boasted eighty men could conquer the Sioux nation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Red Cloud by John K Hillers circa 1880.jpg",
        "credit": "John Karl Hillers",
        "license": "Public domain",
