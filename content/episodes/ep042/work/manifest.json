  "beats": [
    {
      "start": 0.08,
      "end": 3.78,
      "text": "To keep the world alive, the empire plunged itself into total darkness.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Vista completa de Tenochtitl\u00e1n.jpg",
        "credit": "thomas kole",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Vista_completa_de_Tenochtitl%C3%A1n.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.767,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.78,
      "end": 7.32,
      "text": "Every hearth fire across the Aztec realm was extinguished before midnight.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Codex Borbonicus (p. 34).jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Codex_Borbonicus_(p._34).jpg"
      },
      "shots": [
        {
          "start": 3.767,
          "end": 7.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.32,
      "end": 9.28,
      "text": "Parents kept children awake all night to prevent them from turning into mice.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Murales Rivera - Markt in Tlatelolco 3.jpg",
        "credit": "Diego Rivera",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Murales_Rivera_-_Markt_in_Tlatelolco_3.jpg"
      },
      "shots": [
        {
          "start": 7.333,
          "end": 9.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.28,
      "end": 9.56,
      "text": "High atop the Hill of the Star, priests watched the Pleiades.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Plejades.jpg",
        "credit": "Taavi Niittee/T\u00f5rva Astronoomiaklubi/T\u00f5rva Astronomy Club",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Plejades.jpg"
      },
      "shots": [
        {
          "start": 9.267,
          "end": 9.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.56,
      "end": 9.56,
      "text": "Priests cut open a captive's chest to kindle a new flame.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mask of Quetzalcoatl at the British Museum 001.jpg",
        "credit": "Unknown author",
        "license": "CC BY 2.5",
        "url": "https://commons.wikimedia.org/wiki/File:Mask_of_Quetzalcoatl_at_the_British_Museum_001.jpg"
      },
      "shots": [
        {
          "start": 9.567,
          "end": 9.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.56,
      "end": 10.6,
      "text": "Relay runners carried torches across the valley to relight the civilization.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Moctezuma Xocoyotzin.png",
        "credit": "attributed to Antonio Rodriguez (1636-1691)",
        "license": "Public domain",
