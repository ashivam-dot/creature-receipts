          ]
        }
      ]
    },
    {
      "start": 5.921,
      "end": 9.366,
      "text": "But during the delivery voyage, the crew actually used them.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Titanic Belfast 1912.jpg",
        "credit": "John Westbeech Kempster (1864\u20131947)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Titanic_Belfast_1912.jpg"
      },
      "shots": [
        {
