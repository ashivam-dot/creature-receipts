          ]
        }
      ]
    },
    {
      "start": 13.311,
      "end": 17.056,
      "text": "He accidentally kept a locker key in his uniform pocket.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 13.3,
          "end": 17.067,
          "kind": "designed",
