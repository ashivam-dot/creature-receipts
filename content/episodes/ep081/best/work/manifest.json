          ]
        }
      ]
    },
    {
      "start": 17.056,
      "end": 21.981,
      "text": "Frederick Fleet testified that binoculars would have spotted the iceberg sooner.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Iceberg Titanic.png",
        "credit": "\u0160t\u011bp\u00e1n \u0158eho\u0159ek (1888-1935)",
