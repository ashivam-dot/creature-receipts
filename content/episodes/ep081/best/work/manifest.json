        "source": "Wikimedia Commons",
        "title": "David Blair ID photograph.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:David_Blair_ID_photograph.jpg"
      },
      "shots": [
        {
          "start": 9.367,
