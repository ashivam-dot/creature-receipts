      },
      "shots": [
        {
          "start": 19.533,
          "end": 22.267,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.28,
      "end": 25.52,
      "text": "Every brave man perished in history's greatest stand protecting the frontier.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Photograph of the unveiling and inauguration of the Saragarhi Memorial Gurdwara at Amritsar in April 1902.jpg",
        "credit": "Unknown authorUnknown author",
