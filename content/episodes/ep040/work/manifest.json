        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.567,
          "end": 21.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.04,
      "end": 24.74,
      "text": "Havildar Ishar Singh commanded the small garrison holding the heliograph mirror.",
      "asset": {
