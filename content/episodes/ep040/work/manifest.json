          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.527,
      "end": 22.28,
      "text": "Gurmukh Singh signaled live updates across the valley as the fortress walls fell.",
      "asset": {
        "source": "Art Institute of Chicago (CC0)",
        "title": "Encampment of the 71st Regiment",
        "credit": "Roger Fenton\nEnglish, 1819\u20131869",
