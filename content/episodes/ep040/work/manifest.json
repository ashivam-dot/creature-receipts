    {
      "start": 0.08,
      "end": 14.28,
      "text": "Twenty-one Sikh soldiers stood against ten thousand.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Group photograph of the Sikh regiment in British Columbia, Canada after Queen Victoria's Diamond Jubilee, 1897.jpg",
        "credit": "Unknown photographer",
        "license": "Public domain",
