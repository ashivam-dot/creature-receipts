      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.3,
      "end": 7.14,
      "text": "In September of 1897, the isolated Saragarhi outpost faced overwhelming danger on the frontier.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Photograph of the ruins of the Saragarhi Post being guarded by soldiers of the 36th Sikhs standing on its walls after its recapture, 1897.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Photograph_of_the_ruins_of_the_Saragarhi_Post_being_guarded_by_soldiers_of_the_36th_Sikhs_standing_on_its_walls_after_its_recapture,_1897.jpg"
      },
      "shots": [
        {
          "start": 2.3,
          "end": 7.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.14,
      "end": 10.34,
      "text": "Havildar Ishar Singh commanded the small garrison holding the communication lines.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "\u0420\u0438\u0441\u0443\u043d\u043a\u0438 \u043a \u0441\u0442\u0430\u0442\u044c\u0435 \u00ab\u0413\u0435\u043b\u0438\u043e\u0433\u0440\u0430\u0444\u00bb. \u0412\u043a\u043b\u0435\u0439\u043a\u0430 \u2116 1. \u0412\u043e\u0435\u043d\u043d\u0430\u044f \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f \u0421\u044b\u0442\u0438\u043d\u0430 (\u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433, 1911-1915).jpg",
        "credit": "\u00ab\u0412\u043e\u0435\u043d\u043d\u0430\u044f \u044d\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u044f\u00bb \u0418\u0432\u0430\u043d\u0430 \u0414\u043c\u0438\u0442\u0440\u0438\u0435\u0432\u0438\u0447\u0430 \u0421\u044b\u0442\u0438\u043d\u0430. (\u0421\u0430\u043d\u043a\u0442-\u041f\u0435\u0442\u0435\u0440\u0431\u0443\u0440\u0433; 1912 \u0433\u043e\u0434).",
        "license": "Public domain",
