        "url": "https://commons.wikimedia.org/wiki/File:Photograph_of_the_unveiling_and_inauguration_of_the_Saragarhi_Memorial_Gurdwara_at_Amritsar_in_April_1902.jpg"
      },
      "shots": [
        {
          "start": 22.267,
          "end": 25.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
