{
  "id": "ep051",
  "duration": 31.44,
  "beats": [
    {
      "start": 0.08,
      "end": 5.228,
      "text": "A British commander ordered his own intelligence officer onto forced medical leave.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boy Browning (cropped).jpg",
        "credit": "Edward George William Malindine",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boy_Browning_(cropped).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.5,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.5,
          "end": 5.233,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 5.228,
      "end": 10.498,
      "text": "It was September 1944, just before Operation Market Garden launched.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ww2 map68.jpg",
        "credit": "The History Department of the United States Military Academy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ww2_map68.jpg"
      },
      "shots": [
        {
          "start": 5.233,
          "end": 10.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.498,
      "end": 13.993,
      "text": "The officer had spotted German tanks waiting near Arnhem.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Ww2 map68.jpg",
        "credit": "The History Department of the United States Military Academy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Ww2_map68.jpg"
      },
      "shots": [
        {
          "start": 10.5,
          "end": 14.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 13.993,
      "end": 17.938,
      "text": "Commanders ignored the warning and proceeded with the massive drop.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "C-47 Dakotas and paratroops.jpg",
        "credit": "Sgt. D.M. Smith, British Army Film and Photographic Unit",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:C-47_Dakotas_and_paratroops.jpg"
      },
      "shots": [
        {
          "start": 14.0,
          "end": 17.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.938,
      "end": 22.958,
      "text": "They dropped paratroopers directly onto elite German SS panzer divisions.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "First two gliders at Arnhem 17-9-1944, Bestanddeelnr 24023 056.tif",
        "credit": "No 5 Army Film & Photographic Unit / Smith, D.M.",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:First_two_gliders_at_Arnhem_17-9-1944,_Bestanddeelnr_24023_056.tif"
      },
      "shots": [
        {
          "start": 17.933,
          "end": 19.8,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.8,
          "end": 22.967,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 22.958,
      "end": 27.658,
      "text": "The isolated troops were quickly overwhelmed, and the operation failed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Aerial view of the bridge over the Neder Rijn, Arnhem.jpg",
        "credit": "Post-Work: User:W.wolny",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Aerial_view_of_the_bridge_over_the_Neder_Rijn,_Arnhem.jpg"
      },
      "shots": [
        {
          "start": 22.967,
          "end": 24.667,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 24.667,
          "end": 27.667,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 27.658,
      "end": 31.09,
      "text": "They should have listened instead of forcing him onto medical leave.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Boy Browning (cropped).jpg",
        "credit": "Edward George William Malindine",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Boy_Browning_(cropped).jpg"
      },
      "shots": [
        {
          "start": 27.667,
          "end": 31.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
