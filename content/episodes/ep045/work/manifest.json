          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.423,
      "end": 23.843,
      "text": "Almost none of those final 250 children survived the war.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "O\u015bwi\u0119cim (33621909).jpeg",
        "credit": "Greg",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:O%C5%9Bwi%C4%99cim_(33621909).jpeg"
