        }
      ]
    },
    {
      "start": 10.983,
      "end": 15.353,
      "text": "The final train was scheduled for September 1, 1939.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1939 issued Identity Document for travelling to the UK, used by a child on the Kindertransport.jpg",
        "credit": "United Kingdom Government",
        "license": "Public domain",
