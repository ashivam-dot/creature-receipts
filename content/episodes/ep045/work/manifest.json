  "beats": [
    {
      "start": 0.08,
      "end": 4.303,
      "text": "A rescue train planned for 250 children never left Prague.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nicholas Winton (1909-2015) in 1938 by the Associated Press.jpg",
        "credit": "AnonymousUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Nicholas_Winton_(1909-2015)_in_1938_by_the_Associated_Press.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 4.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 4.303,
      "end": 9.873,
      "text": "Nicholas Winton and his team had already helped 669 children reach Britain.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.3,
          "end": 9.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.873,
      "end": 14.417,
      "text": "Their largest planned transport was set to leave Prague in early September.",
      "asset": {
        "source": "local file",
        "path": "/Users/ashivam/Desktop/YouTube/YouTube-Channel-2/.scratch/ep045-winton-repair-20261003/content/episodes/ep045/assets/prague-station-1931-labeled.jpg"
      },
      "shots": [
        {
          "start": 9.867,
          "end": 12.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 12.133,
          "end": 14.433,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 14.417,
      "end": 19.287,
      "text": "On the scheduled day, Germany invaded Poland. The transport was cancelled.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 14.433,
          "end": 19.3,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.287,
      "end": 24.532,
      "text": "Nearly fifty years later, a scrapbook helped bring the rescue work into public view.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nicholas Winton (1909-2015) in 1938 by the Associated Press.jpg",
        "credit": "AnonymousUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Nicholas_Winton_(1909-2015)_in_1938_by_the_Associated_Press.jpg"
      },
      "shots": [
        {
          "start": 19.3,
          "end": 24.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.532,
      "end": 29.138,
      "text": "A memorial at Prague station now honors Winton and the children he helped save.",
