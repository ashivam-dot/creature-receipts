      },
      "shots": [
        {
          "start": 10.967,
          "end": 15.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.353,
      "end": 19.423,
      "text": "That morning, Germany invaded Poland and the borders slammed shut.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Pol5.jpg",
        "credit": "AnonymousUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pol5.jpg"
