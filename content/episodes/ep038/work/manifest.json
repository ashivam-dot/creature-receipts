{
  "id": "ep038",
  "duration": 31.632,
  "beats": [
    {
      "start": 0.08,
      "end": 4.7,
      "text": "Shortly before 10 a.m., New York\u2019s tallest skyscraper vanished into fog.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "De heren Hans Martin van de KLM en Fisher kijken uit over New York vanaf het Emp, Bestanddeelnr 254-2286.jpg",
        "credit": "Willem van de Poll",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:De_heren_Hans_Martin_van_de_KLM_en_Fisher_kijken_uit_over_New_York_vanaf_het_Emp,_Bestanddeelnr_254-2286.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.067,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 3.067,
          "end": 4.7,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 4.7,
      "end": 8.34,
      "text": "Colonel William Smith steered his B-25 bomber toward Midtown Manhattan.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "North American Aviation's B-25 medium bomber, Inglewood, Calif. (LOC).jpg",
        "credit": "Mark Sherwood",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:North_American_Aviation%27s_B-25_medium_bomber,_Inglewood,_Calif._(LOC).jpg"
      },
      "shots": [
        {
          "start": 4.7,
          "end": 8.333,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 8.34,
      "end": 12.26,
      "text": "Flying at 200 miles per hour, the plane struck the 79th floor.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Empire State Building on fire 1945 by INP.jpg",
        "credit": "International News Photos",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Empire_State_Building_on_fire_1945_by_INP.jpg"
      },
      "shots": [
        {
          "start": 8.333,
          "end": 12.267,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 12.26,
      "end": 15.84,
      "text": "One engine plummeted down a shaft, severing the heavy elevator cables.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Empire State Building on fire 1945 by INP.jpg",
        "credit": "International News Photos",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Empire_State_Building_on_fire_1945_by_INP.jpg"
      },
      "shots": [
        {
          "start": 12.267,
          "end": 15.833,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 15.84,
      "end": 19.62,
      "text": "Rescuers placed injured operator Betty Lou Oliver into a car to evacuate her.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Removing casualty from Empire State Building (1945 INP press photo).jpg",
        "credit": "International News Photo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Removing_casualty_from_Empire_State_Building_(1945_INP_press_photo).jpg"
      },
      "shots": [
        {
          "start": 15.833,
          "end": 19.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.62,
      "end": 23.52,
      "text": "The cables snapped, plunging her 75 stories into the subbasement.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bomber Crashed into Empire State Building 1945.jpg",
        "credit": "Acme Newspictures",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bomber_Crashed_into_Empire_State_Building_1945.jpg"
      },
      "shots": [
        {
          "start": 19.633,
          "end": 23.533,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.52,
      "end": 27.04,
      "text": "A cushion of trapped air saved her life from the impossible fall.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bomber Crashed into Empire State Building 1945.jpg",
        "credit": "Acme Newspictures",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bomber_Crashed_into_Empire_State_Building_1945.jpg"
      },
      "shots": [
        {
          "start": 23.533,
          "end": 27.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 27.04,
      "end": 31.282,
      "text": "She survived the morning the tallest skyscraper vanished into fog.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "De heren Hans Martin van de KLM en Fisher kijken uit over New York vanaf het Emp, Bestanddeelnr 254-2286.jpg",
        "credit": "Willem van de Poll",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:De_heren_Hans_Martin_van_de_KLM_en_Fisher_kijken_uit_over_New_York_vanaf_het_Emp,_Bestanddeelnr_254-2286.jpg"
      },
      "shots": [
        {
          "start": 27.033,
          "end": 31.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
