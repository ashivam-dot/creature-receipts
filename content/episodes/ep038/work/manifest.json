  "beats": [
    {
      "start": 0.08,
      "end": 3.26,
      "text": "Shortly before 10 a.m., New York\u2019s tallest skyscraper vanished into fog.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Empire State Building on fire 1945 by INP.jpg",
        "credit": "International News Photos",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Empire_State_Building_on_fire_1945_by_INP.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.267,
          "kind": "cover",
          "motion": "depth",
          "camera_move": [
            1.1,
            1.12,
            0.5,
            0.5,
            0.75,
            0.1
          ]
        }
      ]
    },
    {
      "start": 3.26,
      "end": 5.92,
      "text": "Colonel William Smith steered his B-25 bomber toward Newark.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "North American Aviation's B-25 medium bomber, Inglewood, Calif.jpg",
        "credit": "Mark Sherwood",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:North_American_Aviation%27s_B-25_medium_bomber,_Inglewood,_Calif.jpg"
      },
      "shots": [
        {
          "start": 3.267,
          "end": 5.933,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.12,
            1.12,
            0.85,
            0.15,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 5.92,
      "end": 9.48,
      "text": "At more than 200 miles per hour, it struck the 78th and 79th floors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "After Army bomber rammed Empire State Building (1945 INP press photo).jpg",
        "credit": "International News Photo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:After_Army_bomber_rammed_Empire_State_Building_(1945_INP_press_photo).jpg"
      },
      "shots": [
        {
          "start": 5.933,
          "end": 9.467,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.12,
            0.5,
            0.5,
            0.62,
            0.18
          ]
        }
      ]
    },
    {
      "start": 9.48,
      "end": 12.16,
      "text": "One engine fell down an elevator shaft amid the wreckage.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "After Army bomber rammed Empire State Building (1945 INP press photo).jpg",
        "credit": "International News Photo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:After_Army_bomber_rammed_Empire_State_Building_(1945_INP_press_photo).jpg"
      },
      "shots": [
        {
          "start": 9.467,
          "end": 12.167,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.12,
            1.12,
            0.5,
            0.5,
            0.08,
            0.92
          ]
        }
      ]
    },
    {
      "start": 12.16,
      "end": 14.56,
      "text": "Among the injured was elevator operator Betty Lou Oliver.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Removing casualty from Empire State Building (1945 INP press photo).jpg",
        "credit": "International News Photo",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Removing_casualty_from_Empire_State_Building_(1945_INP_press_photo).jpg"
      },
      "shots": [
        {
          "start": 12.167,
          "end": 14.567,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.1,
            1.12,
            0.18,
            0.82,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 14.56,
      "end": 17.44,
      "text": "Her elevator plunged 75 floors into the subbasement.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bomber Crashed into Empire State Building 1945.jpg",
        "credit": "Acme Newspictures",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bomber_Crashed_into_Empire_State_Building_1945.jpg"
      },
      "shots": [
        {
          "start": 14.567,
          "end": 17.433,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.12,
            1.12,
            0.5,
            0.5,
            0.08,
            0.92
          ]
        }
      ]
    },
    {
      "start": 17.44,
      "end": 20.38,
      "text": "She survived, though her pelvis, back, and neck were broken.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Bomber Crashed into Empire State Building 1945.jpg",
        "credit": "Acme Newspictures",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bomber_Crashed_into_Empire_State_Building_1945.jpg"
      },
      "shots": [
        {
          "start": 17.433,
          "end": 20.367,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.12,
            1.0,
            0.5,
            0.5,
            0.72,
            0.5
          ]
        }
      ]
    },
    {
      "start": 20.38,
      "end": 23.956,
      "text": "She survived the morning the tallest skyscraper vanished into fog.",
