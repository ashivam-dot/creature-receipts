{
  "id": "ep020",
  "duration": 47.097,
  "beats": [
    {
      "start": 0.08,
      "end": 3.728,
      "text": "Winnie the Pooh was a black bear cub bought for twenty dollars.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Black bear large.jpg",
        "credit": "Mike Bender/U.S. Fish and Wildlife Service",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Black_bear_large.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.733,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 3.728,
      "end": 12.898,
      "text": "On August 24, 1914, cavalry veterinarian Lieutenant Harry Colebourn found her at a train stop in White River, Ontario.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.733,
          "end": 12.9,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.898,
      "end": 17.368,
      "text": "He named the bear Winnie after his hometown of Winnipeg, Manitoba.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Hard work for the force, when Duke of Connaught reviews troops Winnipeg Feb 15th 1915.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Hard_work_for_the_force,_when_Duke_of_Connaught_reviews_troops_Winnipeg_Feb_15th_1915.jpg"
      },
      "shots": [
        {
          "start": 12.9,
          "end": 15.133,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 15.133,
          "end": 17.367,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 17.368,
      "end": 24.738,
      "text": "Winnie then sailed to England with Canadian troops aboard the S.S. Manitou on October 3, 1914.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.367,
          "end": 24.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 24.738,
      "end": 29.583,
      "text": "She proudly served as the mascot for the Canadian Army Veterinary Corps.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Winnie the Bear 1915.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Winnie_the_Bear_1915.jpg"
      },
      "shots": [
        {
          "start": 24.733,
          "end": 29.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 29.583,
      "end": 36.628,
      "text": "Colebourn left Winnie at the London Zoo in December 1914 before heading to the battlefields of France.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Die Gartenlaube (1860) 360.jpg",
        "credit": "various",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Die_Gartenlaube_(1860)_360.jpg"
      },
      "shots": [
        {
          "start": 29.6,
          "end": 36.633,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 36.628,
      "end": 43.203,
      "text": "There, young Christopher Robin Milne fell in love with her gentle personality during frequent visits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "London Zoo - Harry Colebourn and Winnie the Bear.jpg",
        "credit": "S Pakhrin",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:London_Zoo_-_Harry_Colebourn_and_Winnie_the_Bear.jpg"
      },
      "shots": [
        {
          "start": 36.633,
          "end": 43.2,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
