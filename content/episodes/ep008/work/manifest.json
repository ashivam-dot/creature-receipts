          "motion": "camera"
        }
      ]
    },
    {
      "start": 41.376,
      "end": 48.771,
      "text": "DNA analysis also proved the bird was male despite early Signal Corps records listing him as a hen.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 41.367,
          "end": 48.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 48.771,
      "end": 54.601,
      "text": "Military records suggest the legendary pigeon's biggest flight was actually a different bird.",
