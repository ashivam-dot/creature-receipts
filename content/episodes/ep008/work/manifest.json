        }
      ]
    },
    {
      "start": 4.151,
      "end": 10.996,
      "text": "On October fourth, nineteen eighteen, the Lost Battalion was trapped in the Argonne Forest under heavy fire.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Zerschossener Argonnenwald, von einem von Soldaten benutzten Ann\u00e4herungsweg (Blauer Weg) durchzogen (Negativ) - LABW - Staatsarchiv Sigmaringen N 1-68 Nr. 1864.jpeg",
        "credit": "Unknown author",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Zerschossener_Argonnenwald,_von_einem_von_Soldaten_benutzten_Ann%C3%A4herungsweg_(Blauer_Weg)_durchzogen_(Negativ)_-_LABW_-_Staatsarchiv_Sigmaringen_N_1-68_Nr._1864.jpeg"
      },
      "shots": [
        {
          "start": 4.167,
          "end": 11.0,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.996,
      "end": 16.941,
      "text": "Major Charles Whittlesey wrote an urgent message asking to stop the friendly fire barrage.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Charles W. Whittlesey - WWI Medal of Honor recipient.jpg",
        "credit": "United States Army",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Charles_W._Whittlesey_-_WWI_Medal_of_Honor_recipient.jpg"
      },
      "shots": [
        {
          "start": 11.0,
          "end": 16.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.941,
      "end": 22.486,
      "text": "Private Omer Richards released Cher Ami into the smoke-filled air to carry the plea.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Franco-British carrier ready to be released to carry a long distance message - Flickr - National Library of Scotland.jpg",
        "credit": "National Library of Scotland from Scotland",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Franco-British_carrier_ready_to_be_released_to_carry_a_long_distance_message_-_Flickr_-_National_Library_of_Scotland.jpg"
      },
      "shots": [
        {
          "start": 16.933,
          "end": 19.033,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 19.033,
          "end": 22.5,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.486,
      "end": 28.331,
      "text": "The brave bird flew twenty-five miles in just twenty-five minutes back to division headquarters.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Feral pigeon flying, Chiang Mai, Thailand.jpg",
        "credit": "Hotcatssan",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Feral_pigeon_flying,_Chiang_Mai,_Thailand.jpg"
      },
      "shots": [
        {
          "start": 22.5,
          "end": 25.333,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 25.333,
          "end": 28.333,
          "kind": "detail",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.331,
      "end": 33.756,
      "text": "During that dangerous flight, Cher Ami was shot in the chest and nearly lost a leg.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "FRENCH MEDALS. CROIX DE GUERRE LCCN2016869113.jpg",
        "credit": "Harris & Ewing, photographer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:FRENCH_MEDALS._CROIX_DE_GUERRE_LCCN2016869113.jpg"
      },
      "shots": [
        {
          "start": 28.333,
          "end": 33.767,
          "kind": "cover",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 33.756,
      "end": 41.376,
      "text": "Smithsonian curator Frank [Blazich](/bl\u02c8Az\u02c8\u026a\u02a7/) notes official records show the wounding happened on a different mission entirely.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "2022-1013-grace-young-julia-child-award 12.jpg",
        "credit": "Fuzheado",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:2022-1013-grace-young-julia-child-award_12.jpg"
      },
      "shots": [
        {
          "start": 33.767,
          "end": 37.567,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 37.567,
