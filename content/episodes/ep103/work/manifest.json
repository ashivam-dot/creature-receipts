    },
    {
      "start": 10.917,
      "end": 15.087,
      "text": "It became the largest human-made explosion before the atomic age.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 10.933,
          "end": 15.1,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 15.087,
      "end": 18.157,
      "text": "The Richmond district was completely obliterated.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Halifax Explosion - harbour view - restored.jpg",
        "credit": "William James (Toronto)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Halifax_Explosion_-_harbour_view_-_restored.jpg"
      },
      "shots": [
