    {
      "start": 4.145,
      "end": 9.84,
      "text": "In 1883, over eleven hundred children packed Victoria Hall in Sunderland.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.133,
          "end": 9.833,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 9.84,
      "end": 13.26,
      "text": "Free toys were promised, triggering a rush down the stairs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Victoria Hall crush.jpg",
        "credit": "G. Julien",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Victoria_Hall_crush.jpg"
      },
      "shots": [
        {
          "start": 9.833,
          "end": 13.267,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 13.26,
      "end": 17.43,
      "text": "At the bottom, an inward door was bolted open one child wide.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Plan of Victoria Hall, Sunderland.webp",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Plan_of_Victoria_Hall,_Sunderland.webp"
      },
      "shots": [
        {
          "start": 13.267,
          "end": 17.433,
          "kind": "cover",
          "motion": "depth",
          "camera_move": [
            1.1,
            1.1,
            0.5,
            0.5,
            0.85,
            0.15
          ]
        }
      ]
    },
    {
      "start": 17.43,
      "end": 21.95,
      "text": "Trapped against it, 183 children suffocated in the stairs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mowbary Park Little Garden - panoramio.jpg",
        "credit": "somaliayaswan",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Mowbary_Park_Little_Garden_-_panoramio.jpg"
      },
      "shots": [
        {
          "start": 17.433,
          "end": 21.967,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 21.95,
      "end": 26.095,
      "text": "The disaster forced new laws creating push-bar emergency exits.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Emergency Exit Doors (49399118683).jpg",
        "credit": "Mike Mozart from Funny YouTube, USA",
        "license": "CC BY 2.0",
        "url": "https://commons.wikimedia.org/wiki/File:Emergency_Exit_Doors_(49399118683).jpg"
      },
      "shots": [
        {
          "start": 21.967,
          "end": 26.1,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
            0.5,
            0.5,
            0.5,
