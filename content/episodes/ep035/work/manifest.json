{
  "id": "ep035",
  "duration": 29.163,
  "beats": [
    {
      "start": 0.08,
      "end": 4.5,
      "text": "Galveston\u2019s weather chief raised hurricane flags the day before disaster.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Isaac Cline Young National Archives.jpg",
        "credit": "Photographer not credited",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Isaac_Cline_Young_National_Archives.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.633,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 1.633,
          "end": 4.5,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 4.5,
      "end": 9.02,
      "text": "Earlier federal warnings had pointed toward Florida and the eastern Gulf.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 4.5,
          "end": 9.033,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 9.02,
      "end": 13.79,
      "text": "The weather service says Isaac Cline urged residents to move to higher ground.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Isaac Cline Young National Archives.jpg",
        "credit": "Photographer not credited",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Isaac_Cline_Young_National_Archives.jpg"
      },
      "shots": [
        {
          "start": 9.033,
          "end": 13.8,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 13.79,
      "end": 17.585,
      "text": "On September eighth, a fifteen-foot surge swallowed Galveston.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galveston's awful calamity - Gulf tidal wave, September 8th 1900",
        "credit": "Kurz & Allison",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galveston%27s_awful_calamity_-_Gulf_tidal_wave,_September_8th_1900_LCCN2014645198.jpg"
      },
      "shots": [
        {
          "start": 13.8,
          "end": 17.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.585,
      "end": 22.055,
      "text": "The island\u2019s highest ground was just eight point seven feet above sea level.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.6,
          "end": 22.067,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.055,
      "end": 25.65,
      "text": "More than eight thousand died, including Cline\u2019s pregnant wife.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "St Patrick's Church, Galveston hurricane, 1900",
        "credit": "Photographer unknown",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:St_Patrick%27s_Church,_Galveston_hurricane,_1900.jpg"
      },
      "shots": [
        {
          "start": 22.067,
          "end": 25.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.65,
      "end": 28.813,
      "text": "It remains America\u2019s deadliest natural disaster.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 25.667,
          "end": 29.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    }
  ],
