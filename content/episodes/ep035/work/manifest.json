{
  "id": "ep035",
  "duration": 27.603,
  "beats": [
    {
      "start": 0.08,
      "end": 4.0,
      "text": "Galveston\u2019s weather chief Isaac Cline promised that a major hurricane was impossible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Isaac Cline Young National Archives.jpg",
        "credit": "Photographer not credited",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Isaac_Cline_Young_National_Archives.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.667,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 1.667,
          "end": 4.0,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 4.0,
      "end": 7.16,
      "text": "The city felt safe, expecting the storm to curve toward Florida.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galveston - Strand, by A. V. Latourette.png",
        "credit": "Latourette, A. V. -- Photographer",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galveston_-_Strand,_by_A._V._Latourette.png"
      },
      "shots": [
        {
          "start": 4.0,
          "end": 7.167,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.16,
      "end": 10.58,
      "text": "Expert Cuban meteorologists knew the monster was heading straight for Texas.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Galveston hurricane weather map 9-9-1900 (9864201).jpg",
        "credit": "NOAA Library",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Galveston_hurricane_weather_map_9-9-1900_(9864201).jpg"
      },
      "shots": [
        {
          "start": 7.167,
          "end": 10.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 10.58,
      "end": 13.28,
      "text": "Willis Moore blocked their warnings out of professional jealousy.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Willis L. Moore LCCN2014683876.jpg",
        "credit": "Bain News Service, publisher",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Willis_L._Moore_LCCN2014683876.jpg"
      },
      "shots": [
        {
          "start": 10.567,
          "end": 13.267,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 13.28,
      "end": 16.08,
      "text": "Moore even banned the word hurricane to avoid a panic.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1900 Galveston hurricane weather map (high quality) (19877020).jpg",
        "credit": "NOAA",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1900_Galveston_hurricane_weather_map_(high_quality)_(19877020).jpg"
      },
      "shots": [
        {
          "start": 13.267,
          "end": 16.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.08,
      "end": 19.84,
      "text": "On September 8, 1900, a fifteen-foot surge swallowed the city.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 16.067,
          "end": 19.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.84,
      "end": 23.7,
      "text": "At least 8,000 people perished in America\u2019s deadliest natural disaster.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.833,
          "end": 23.7,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.7,
      "end": 27.253,
      "text": "Many died believing the man who promised a hurricane was impossible.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Isaac Cline Young National Archives.jpg",
        "credit": "Photographer not credited",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Isaac_Cline_Young_National_Archives.jpg"
      },
      "shots": [
        {
          "start": 23.7,
          "end": 27.6,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    }
  ],
