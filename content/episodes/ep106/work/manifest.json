    {
      "start": 4.05,
      "end": 8.095,
      "text": "By afternoon, birds and jackrabbits fled the Oklahoma plains.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Abandoned Dust Bowl Home - Dorothea Lange.jpg",
        "credit": "Dorothea Lange",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Abandoned_Dust_Bowl_Home_-_Dorothea_Lange.jpg"
      },
      "shots": [
        {
          "start": 4.033,
          "end": 8.1,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
