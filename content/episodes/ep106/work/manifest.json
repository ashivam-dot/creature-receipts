            0.5,
            0.45
          ]
        }
      ]
    },
    {
      "start": 12.47,
      "end": 15.565,
      "text": "It turned so black people could not see their hands.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dust storm in Spearman,Texas, Wea01422.jpg",
        "credit": "Monthly Weather Review, Volume 63, April 1935, p. 148.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dust_storm_in_Spearman,Texas,_Wea01422.jpg"
      },
      "shots": [
        {
          "start": 12.467,
          "end": 15.567,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
