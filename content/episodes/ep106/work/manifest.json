            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 8.095,
      "end": 12.47,
      "text": "A wall of three hundred thousand tons of topsoil struck Oklahoma.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Dust storm approaching Stratford, Texas.jpg",
        "credit": "George Everett Marsh Jr.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Dust_storm_approaching_Stratford,_Texas.jpg"
      },
      "shots": [
        {
          "start": 8.1,
          "end": 9.7,
