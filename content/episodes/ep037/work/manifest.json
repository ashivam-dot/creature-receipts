  "beats": [
    {
      "start": 0.08,
      "end": 2.7,
      "text": "Roald Amundsen told the world he was sailing for the North Pole.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen-Fram.jpg",
        "credit": "UnknownUnknown  , Archival Photograph by Mr. Steve Nicklas, NOS, NGS",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen-Fram.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 2.7,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 2.7,
      "end": 5.96,
      "text": "In September 1910, he secretly turned his ship toward Antarctica.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen-in-ice.jpg",
        "credit": "Anders Beer Wilse",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen-in-ice.jpg"
      },
      "shots": [
        {
          "start": 2.7,
          "end": 5.967,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 5.96,
      "end": 9.84,
      "text": "By October 1911, five men and fifty-two dogs began the march.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Le Tour du monde, nouvelle s\u00e9rie-19-p107.jpg",
        "credit": "Le Tour du monde",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Le_Tour_du_monde,_nouvelle_s%C3%A9rie-19-p107.jpg"
      },
      "shots": [
        {
          "start": 5.967,
          "end": 9.833,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 9.84,
      "end": 12.88,
      "text": "High on a glacier, the team finally ran out of food.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Axel Heiberg Glacier - Antarctica.JPG",
        "credit": "Commander Jim Waldron USNR (Retired), Officer-in-Charge of the VX-6 Detachment at Little America V at the time of photograph[2]",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Axel_Heiberg_Glacier_-_Antarctica.JPG"
      },
      "shots": [
        {
          "start": 9.833,
          "end": 12.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.88,
      "end": 15.96,
      "text": "Amundsen slaughtered his own dogs to feed the survivors.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Le Tour du monde, nouvelle s\u00e9rie-19-p095.jpg",
        "credit": "Le Tour du monde",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Le_Tour_du_monde,_nouvelle_s%C3%A9rie-19-p095.jpg"
      },
      "shots": [
        {
          "start": 12.867,
          "end": 15.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.96,
      "end": 19.6,
      "text": "On December 14, they reached the pole weeks before Scott.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Taking hold of the camera at the South Pole, 14th December, 1911 (26544158928).jpg",
        "credit": "National Library of Australia from Canberra, Australia",
        "license": "No restrictions",
        "url": "https://commons.wikimedia.org/wiki/File:Taking_hold_of_the_camera_at_the_South_Pole,_14th_December,_1911_(26544158928).jpg"
      },
      "shots": [
        {
          "start": 15.967,
          "end": 19.6,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.6,
      "end": 22.66,
      "text": "He won the race but sacrificed forty-one dogs.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Amundsen's expedition at the South Pole - LOC 3c01002u.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Amundsen%27s_expedition_at_the_South_Pole_-_LOC_3c01002u.jpg"
      },
      "shots": [
        {
          "start": 19.6,
          "end": 22.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 22.66,
      "end": 26.174,
      "text": "While he stood at the South Pole, the world still thought he was...",
