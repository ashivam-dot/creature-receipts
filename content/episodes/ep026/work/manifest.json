    {
      "start": 0.08,
      "end": 3.653,
      "text": "Up to twenty-five hundred people died in the Peshtigo Fire.",
      "asset": {
        "source": "Wikimedia Commons / Library of Congress",
        "title": "Bird's eye view of Peshtigo, Wisconsin Sept. 1871. LOC 93681235.jpg",
        "credit": "T.M. Fowler & Co.; Charles Shober & Co.; Chicago Lithographing Co.",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Bird's_eye_view_of_Peshtigo,_Wisconsin_Sept._1871._LOC_93681235.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.667,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.653,
      "end": 7.773,
      "text": "October eighth, eighteen seventy-one: Wisconsin's forests were dry.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.667,
          "end": 7.767,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.773,
      "end": 12.043,
      "text": "Strong southwest winds fanned smoldering fires across Wisconsin.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "1871-peshtigo-fire-historical-events-u2.jpg",
        "credit": "Unknown artist; contemporary American newspaper",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:1871-peshtigo-fire-historical-events-u2.jpg"
      },
      "shots": [
        {
          "start": 7.767,
          "end": 12.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.043,
      "end": 15.513,
      "text": "A firestorm swallowed Peshtigo in less than two hours.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 15.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.513,
      "end": 19.058,
      "text": "Father Peter Pernin survived by sheltering in the river.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Peshtigo Fire showing people seeking refuge in the Peshtigo River.jpg",
        "credit": "G. J. Tisdale; Harper\u2019s Weekly, 1871",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:The_Peshtigo_Fire_showing_people_seeking_refuge_in_the_Peshtigo_River.jpg"
      },
      "shots": [
        {
          "start": 15.5,
          "end": 19.067,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.058,
      "end": 23.728,
      "text": "Only two buildings remained. It became America's deadliest wildfire.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 19.067,
          "end": 23.733,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.728,
      "end": 26.707,
      "text": "Chicago burned that same night and took the headlines.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "The Great fire at Chicago. Scene in Wells Street - the terrified populace in front of the Briggs House, which has just caught fire - from a sketch by our special artist. LCCN94501371.jpg",
