  "duration": 31.188,
  "beats": [
    {
      "start": 0.08,
      "end": 3.9,
      "text": "Up to twenty-five hundred people vanished in a single fiery night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration - Peshtigo Fire in WI, 10-8-1871 (22139919004).jpg",
        "credit": "U.S. Forest Service- Pacific Northwest Region",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_-_Peshtigo_Fire_in_WI,_10-8-1871_(22139919004).jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.9,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.9,
      "end": 7.94,
      "text": "Severe drought gripped Wisconsin on October eighth, eighteen seventy one.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 3.9,
          "end": 7.933,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 7.94,
      "end": 12.04,
      "text": "A cold front created winds reaching one hundred ten miles per hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Lick Fire on the Umatilla National Forest burning at night.jpg",
        "credit": "U.S. Forest Service- Pacific Northwest Region",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Lick_Fire_on_the_Umatilla_National_Forest_burning_at_night.jpg"
      },
      "shots": [
        {
          "start": 7.933,
          "end": 12.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.04,
      "end": 17.46,
      "text": "The blaze reached two thousand degrees Fahrenheit and vaporized entire forests.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 17.467,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.46,
      "end": 21.36,
      "text": "Father Peter Pernin survived by immersing himself in the freezing river.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Title page of Pernin, The Finger of God is there!.jpg",
        "credit": "Peter Pernin",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Title_page_of_Pernin,_The_Finger_of_God_is_there!.jpg"
      },
      "shots": [
        {
          "start": 17.467,
          "end": 21.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 21.36,
      "end": 25.46,
      "text": "This remains the deadliest wildfire in all of American history.",
      "asset": {
        "source": "Art Institute of Chicago (CC0)",
        "title": "Cemetery, Cathcart's Hill",
        "credit": "Roger Fenton\nEnglish, 1819\u20131869",
        "license": "CC0",
        "url": "https://www.artic.edu/artworks/123412"
      },
      "shots": [
        {
          "start": 21.367,
          "end": 25.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.46,
      "end": 30.838,
      "text": "Chicago erupted four hundred miles south that same night, casting these victims into shadow.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Illustration - Peshtigo Fire in WI, 10-8-1871 (22139919004).jpg",
        "credit": "U.S. Forest Service- Pacific Northwest Region",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Illustration_-_Peshtigo_Fire_in_WI,_10-8-1871_(22139919004).jpg"
      },
      "shots": [
        {
          "start": 25.467,
          "end": 31.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    }
  ],
