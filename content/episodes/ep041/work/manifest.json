{
  "id": "ep041",
  "duration": 26.128,
  "beats": [
    {
      "start": 0.08,
      "end": 3.46,
      "text": "The Nazca destroyed their ecosystem by clearing trees to carve giant lines.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nasca - Triangulos - panoramio.jpg",
        "credit": "Pavel \u0160pindler",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nasca_-_Triangulos_-_panoramio.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.467,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.46,
      "end": 8.18,
      "text": "Intricate geoglyphs of animals stretched across more than 1,300 kilometers of dry plateau.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nazca Lines Hummingbird.jpg",
        "credit": "Unukorno",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nazca_Lines_Hummingbird.jpg"
      },
      "shots": [
        {
          "start": 3.467,
          "end": 5.867,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 5.867,
          "end": 8.167,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 8.18,
      "end": 12.02,
      "text": "Expanding maize and cotton agriculture required removing deep-rooted Huarango trees.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Starr 050924-4469 Prosopis pallida.jpg",
        "credit": "Forest & Kim Starr",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Starr_050924-4469_Prosopis_pallida.jpg"
      },
      "shots": [
        {
          "start": 8.167,
          "end": 12.033,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 12.02,
      "end": 15.84,
      "text": "An El Ni\u00f1o event around 500 AD unleashed torrential coastal flooding.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.033,
          "end": 15.833,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.84,
      "end": 19.24,
      "text": "Without root systems, the unprotected soil washed away into deep river channels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Puquios aqueduct Nazca Peru.JPG",
        "credit": "Ab5602 (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Puquios_aqueduct_Nazca_Peru.JPG"
      },
      "shots": [
        {
          "start": 15.833,
          "end": 19.233,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.24,
      "end": 22.36,
      "text": "Their aqueducts dried up, collapsing the civilization into desert.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Subjects with heads in Paracas and Nasca cultures.jpg",
        "credit": "Vicpeters",
        "license": "CC BY 4.0",
        "url": "https://commons.wikimedia.org/wiki/File:Subjects_with_heads_in_Paracas_and_Nasca_cultures.jpg"
      },
      "shots": [
        {
          "start": 19.233,
          "end": 22.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
