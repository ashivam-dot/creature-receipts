  "beats": [
    {
      "start": 0.08,
      "end": 3.88,
      "text": "Before their civilization collapsed, the Nazca cut down their own desert defense.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nasca - Triangulos - panoramio.jpg",
        "credit": "Pavel \u0160pindler",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nasca_-_Triangulos_-_panoramio.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 3.867,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 3.88,
      "end": 8.6,
      "text": "Intricate geoglyphs of animals stretched across more than 1,300 kilometers of dry plateau.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Nazca Lines Hummingbird.jpg",
        "credit": "Unukorno",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:Nazca_Lines_Hummingbird.jpg"
      },
      "shots": [
        {
          "start": 3.867,
          "end": 6.467,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.467,
          "end": 8.6,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 8.6,
      "end": 12.34,
      "text": "Expanding agriculture drove them to clear the deep-rooted Huarango trees.",
      "asset": {
        "source": "iNaturalist",
        "title": "kiawe (Neltuma pallida)",
        "credit": "(c) Liam Gerry, some rights reserved (CC BY)",
        "license": "CC BY 4.0",
        "url": "https://www.inaturalist.org/observations/230177551"
      },
      "shots": [
        {
          "start": 8.6,
          "end": 12.333,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 12.34,
      "end": 16.86,
      "text": "An El Ni\u00f1o event around 500 AD unleashed torrential coastal flooding.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.333,
          "end": 16.867,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 16.86,
      "end": 20.42,
      "text": "Without root systems, the unprotected soil washed away into deep river channels.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Puquios aqueduct Nazca Peru.JPG",
        "credit": "Ab5602 (talk)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Puquios_aqueduct_Nazca_Peru.JPG"
      },
      "shots": [
        {
          "start": 16.867,
          "end": 20.433,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.42,
      "end": 23.36,
      "text": "Floods destroyed their canals, leaving future generations to wonder...",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gold Headband Mask, 100 BC - 550 AD, Nazca - Houston Museum of Natural Science - DSC02147.JPG",
        "credit": "Daderot",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Gold_Headband_Mask,_100_BC_-_550_AD,_Nazca_-_Houston_Museum_of_Natural_Science_-_DSC02147.JPG"
      },
      "shots": [
        {
          "start": 20.433,
          "end": 23.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
