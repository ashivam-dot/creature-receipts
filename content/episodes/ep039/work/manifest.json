        "source": "Wikimedia Commons",
        "title": "H\u014dj\u014d Tokimune.jpg",
        "credit": "Unknown",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:H%C5%8Dj%C5%8D_Tokimune.jpg"
      },
      "shots": [
        {
          "start": 14.6,
