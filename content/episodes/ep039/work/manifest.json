    {
      "start": 0.08,
      "end": 3.44,
      "text": "Four thousand ships sailed to conquer Japan.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M\u014dko Sh\u016brai Ekotoba Mongol Invasion Takezaki Suenaga 2 Page 5-7.jpg",
        "credit": "Tosa Nagataka",
