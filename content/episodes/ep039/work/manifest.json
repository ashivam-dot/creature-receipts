          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 17.6,
      "end": 20.56,
      "text": "A twenty-kilometer stone wall blocked the invaders from landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Genko-Borui.JPG",
        "credit": "User: (WT-shared) Tanuki at  wts wikivoyage",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Genko-Borui.JPG"
      },
      "shots": [
        {
          "start": 17.6,
          "end": 20.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.56,
      "end": 23.38,
      "text": "For seven weeks, samurai boats harassed the stalled fleet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Mooko-SamuraiShips.jpg",
        "credit": "Unknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Mooko-SamuraiShips.jpg"
      },
      "shots": [
        {
          "start": 20.567,
          "end": 23.367,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 23.38,
      "end": 25.92,
      "text": "Desperate Mongols lashed their ships together with heavy chains.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Takezaki suenaga ekotoba3.jpg",
        "credit": "Takezaki Suenaga",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Takezaki_suenaga_ekotoba3.jpg"
      },
      "shots": [
        {
          "start": 23.367,
          "end": 25.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.92,
      "end": 28.98,
      "text": "On August 15, a monster typhoon smashed the trapped armada.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KATSUSHIKA Isai NICHIREN SH\u014cNIN ICHIDAI ZUE 1858 KAMIKAZE.jpg",
        "credit": "\u30a6\u30a3\u30ad\u592a\u90ce (Wiki Taro)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KATSUSHIKA_Isai_NICHIREN_SH%C5%8CNIN_ICHIDAI_ZUE_1858_KAMIKAZE.jpg"
      },
      "shots": [
        {
          "start": 25.933,
          "end": 28.967,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.98,
      "end": 32.14,
      "text": "Over one hundred thousand men drowned when the chained ships shattered.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kyushu National Museum 20230224 103.jpg",
        "credit": "\u5148\u5f93\u9697\u59cb",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Kyushu_National_Museum_20230224_103.jpg"
      },
      "shots": [
        {
          "start": 28.967,
          "end": 32.133,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 32.14,
      "end": 36.336,
      "text": "Fourteen thousand ships sailed to conquer Japan before the storm struck.",
