      ]
    },
    {
      "start": 17.5,
      "end": 21.46,
      "text": "Regent Hojo Tokimune refused to surrender and beheaded the envoys.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "H\u014dj\u014d Tokimune.jpg",
        "credit": "Unknown",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:H%C5%8Dj%C5%8D_Tokimune.jpg"
      },
      "shots": [
        {
          "start": 17.5,
          "end": 21.467,
          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 21.46,
      "end": 25.1,
      "text": "A 20-kilometer stone wall blocked the armada from landing.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Genko-Borui.JPG",
        "credit": "User: (WT-shared) Tanuki at  wts wikivoyage",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Genko-Borui.JPG"
      },
      "shots": [
        {
          "start": 21.467,
          "end": 25.1,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 25.1,
      "end": 28.49,
      "text": "For seven weeks, samurai in tiny boats raided the fleet.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "M\u014dko Sh\u016brai Ekotoba e14.jpg",
        "credit": "\u7af9\u5d0e\u5b63\u9577",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:M%C5%8Dko_Sh%C5%ABrai_Ekotoba_e14.jpg"
      },
      "shots": [
        {
          "start": 25.1,
          "end": 28.5,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 28.49,
      "end": 31.58,
      "text": "The Mongols chained their ships together to survive the raids.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Takezaki suenaga ekotoba3.jpg",
        "credit": "Takezaki Suenaga",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Takezaki_suenaga_ekotoba3.jpg"
      },
      "shots": [
        {
          "start": 28.5,
          "end": 31.567,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 31.58,
      "end": 35.3,
      "text": "Suddenly, on August 15, a monster typhoon struck the coast.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "KATSUSHIKA Isai NICHIREN SH\u014cNIN ICHIDAI ZUE 1858 KAMIKAZE.jpg",
        "credit": "\u30a6\u30a3\u30ad\u592a\u90ce (Wiki Taro)",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:KATSUSHIKA_Isai_NICHIREN_SH%C5%8CNIN_ICHIDAI_ZUE_1858_KAMIKAZE.jpg"
      },
      "shots": [
        {
          "start": 31.567,
          "end": 35.3,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 35.3,
      "end": 37.94,
      "text": "At least 100,000 men drowned in one night.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Kyushu National Museum 20230224 103.jpg",
        "credit": "\u5148\u5f93\u9697\u59cb",
        "license": "CC0",
        "url": "https://commons.wikimedia.org/wiki/File:Kyushu_National_Museum_20230224_103.jpg"
      },
      "shots": [
        {
          "start": 35.3,
          "end": 37.933,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 37.94,
      "end": 40.414,
      "text": "Four thousand ships sailed to their doom.",
