          "motion": "depth"
        }
      ]
    },
    {
      "start": 16.086,
      "end": 19.731,
      "text": "They faced 800 miles of the world's deadliest ocean.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Shackleton Endurance Aurora map2.png",
        "credit": "Finetooth, Like tears in rain, U.S Central Intelligence Agency",
        "license": "Public domain",
