        }
      ]
    },
    {
      "start": 12.616,
      "end": 16.086,
      "text": "Shackleton relied entirely on Worsley's navigation.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Worsley, 1917.jpg",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
