          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.731,
      "end": 23.806,
      "text": "Worsley found land using only four fleeting sun sightings.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "James Caird bow.jpg",
        "credit": "Rumping",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:James_Caird_bow.jpg"
