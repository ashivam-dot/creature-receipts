  "beats": [
    {
      "start": 0.08,
      "end": 3.313,
      "text": "Sitting Bull saw soldiers falling before they even arrived.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "En-chief-sitting-bull.jpg",
        "credit": "David Francis Barry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:En-chief-sitting-bull.jpg"
      },
      "shots": [
        {
