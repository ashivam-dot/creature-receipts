          "kind": "cover",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 3.313,
      "end": 7.583,
      "text": "In June 1876, George Custer approached the Little Bighorn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Gen. George A. Custer - NARA - 528637.jpg",
        "credit": "Mathew Benjamin Brady",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Gen._George_A._Custer_-_NARA_-_528637.jpg"
      },
      "shots": [
        {
          "start": 3.3,
          "end": 6.267,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 6.267,
          "end": 7.567,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 7.583,
      "end": 10.428,
      "text": "His scouts warned him the village was too massive.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait of Curley, A Crow Indian Scout with the Seventh Cavalry at the Battle of the Little Bighorn - NARA - 533090.jpg",
        "credit": "David Francis Barry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portrait_of_Curley,_A_Crow_Indian_Scout_with_the_Seventh_Cavalry_at_the_Battle_of_the_Little_Bighorn_-_NARA_-_533090.jpg"
      },
      "shots": [
        {
          "start": 7.567,
          "end": 9.133,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 9.133,
          "end": 10.433,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 10.428,
      "end": 14.273,
      "text": "He ignored them, unaware General Crook had already retreated.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "George Crook - Brady-Handy.jpg",
        "credit": "Mathew Benjamin Brady / Levin Corbin Handy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:George_Crook_-_Brady-Handy.jpg"
      },
      "shots": [
        {
          "start": 10.433,
          "end": 12.333,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 12.333,
          "end": 14.267,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 14.273,
      "end": 17.193,
      "text": "Custer split his force to stop them escaping.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Custer's route from Ft. Abraham Lincoln to Little Bighorn River, Crow Reservation, 1876.png",
        "credit": "Unknown authorUnknown author",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Custer%27s_route_from_Ft._Abraham_Lincoln_to_Little_Bighorn_River,_Crow_Reservation,_1876.png"
      },
      "shots": [
        {
          "start": 14.267,
          "end": 17.2,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 17.193,
      "end": 20.493,
      "text": "His final note begged for help that never arrived.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.2,
          "end": 20.5,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 20.493,
      "end": 23.313,
      "text": "Over 200 men were wiped out in an hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Custer Monument on Last Stand Hill After its Completion (1f50cb51d68b4015a1a61c673c88179b).tif",
