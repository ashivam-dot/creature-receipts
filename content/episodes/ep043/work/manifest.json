{
  "id": "ep043",
  "duration": 26.057,
  "beats": [
    {
      "start": 0.08,
      "end": 3.08,
      "text": "Sitting Bull saw the soldiers falling long before they arrived.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "En-chief-sitting-bull.jpg",
        "credit": "David Francis Barry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:En-chief-sitting-bull.jpg"
      },
      "shots": [
        {
          "start": 0.0,
          "end": 1.433,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 1.433,
          "end": 3.067,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 3.08,
      "end": 6.78,
      "text": "In June 1876, George Custer rode toward the Little Bighorn.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "G a custer.jpg",
        "credit": "George L. Andrews",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:G_a_custer.jpg"
      },
      "shots": [
        {
          "start": 3.067,
          "end": 4.933,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 4.933,
          "end": 6.767,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 6.78,
      "end": 9.64,
      "text": "Crow scouts warned him that the village was unprecedented.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Portrait of Curley, A Crow Indian Scout with the Seventh Cavalry at the Battle of the Little Bighorn - NARA - 533090.jpg",
        "credit": "David Francis Barry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Portrait_of_Curley,_A_Crow_Indian_Scout_with_the_Seventh_Cavalry_at_the_Battle_of_the_Little_Bighorn_-_NARA_-_533090.jpg"
      },
      "shots": [
        {
          "start": 6.767,
          "end": 8.433,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 8.433,
          "end": 9.633,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 9.64,
      "end": 12.96,
      "text": "Custer ignored them, unaware a supporting army had already retreated.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "George Crook - Brady-Handy.jpg",
        "credit": "Mathew Benjamin Brady / Levin Corbin Handy",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:George_Crook_-_Brady-Handy.jpg"
      },
      "shots": [
        {
          "start": 9.633,
          "end": 11.3,
          "kind": "cover",
          "motion": "depth"
        },
        {
          "start": 11.3,
          "end": 12.967,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 12.96,
      "end": 15.62,
      "text": "He split his regiment to prevent the families from scattering.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "A Little Bighorn-i csata t\u00e9rk\u00e9pe.png",
        "credit": "Carlos71",
        "license": "CC BY 3.0",
        "url": "https://commons.wikimedia.org/wiki/File:A_Little_Bighorn-i_csata_t%C3%A9rk%C3%A9pe.png"
      },
      "shots": [
        {
          "start": 12.967,
          "end": 15.633,
          "kind": "card",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 15.62,
      "end": 19.16,
      "text": "A final desperate note begged for reinforcements that never came.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 15.633,
          "end": 19.167,
          "kind": "designed",
          "motion": "camera"
        }
      ]
    },
    {
      "start": 19.16,
      "end": 22.96,
      "text": "Over 200 cavalrymen were annihilated on a ridge within an hour.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "Custer Monument on Last Stand Hill After its Completion (1f50cb51d68b4015a1a61c673c88179b).tif",
        "credit": "David Francis Barry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Custer_Monument_on_Last_Stand_Hill_After_its_Completion_(1f50cb51d68b4015a1a61c673c88179b).tif"
      },
      "shots": [
        {
          "start": 19.167,
          "end": 20.733,
          "kind": "card",
          "motion": "camera"
        },
        {
          "start": 20.733,
          "end": 22.967,
          "kind": "detail",
          "motion": "depth"
        }
      ]
    },
    {
      "start": 22.96,
      "end": 25.707,
      "text": "Sitting Bull's vision of falling soldiers had come true.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "En-chief-sitting-bull.jpg",
        "credit": "David Francis Barry",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:En-chief-sitting-bull.jpg"
      },
      "shots": [
        {
