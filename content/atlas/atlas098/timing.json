  "beats": [
    {
      "start": 0.25,
      "end": 8.745041666666667,
      "text": "In South Africa, the richest fifth holds 59.5% of income. In Slovakia, it is 32.8%."
    },
    {
      "start": 8.745041666666667,
      "end": 14.620041666666667,
      "text": "South Africa has 1.8 times the share Slovakia does. It is the world's highest."
    },
    {
      "start": 14.620041666666667,
      "end": 19.495041666666665,
      "text": "This counts the share of income or consumption that flows to the top quintile."
    },
    {
      "start": 19.495041666666665,
      "end": 21.820041666666665,
      "text": "Slovakia is the world's lowest."
    },
    {
      "start": 21.820041666666665,
      "end": 27.920041666666663,
      "text": "The USA has 47.1%. China has 43.7%."
    },
    {
      "start": 27.920041666666663,
      "end": 37.87004166666666,
      "text": "Shares in South America are high: Colombia: 58.9%, Brazil: 55.4%, and Paraguay: 50.2%."
    },
    {
      "start": 37.87004166666666,
      "end": 40.945041666666654,
      "text": "India is low with 34.2%."
    },
    {
      "start": 40.945041666666654,
      "end": 42.72737499999999,
      "text": "Who holds the wealth where you live?"
    }
  ]
}