          ]
        }
      ]
    },
    {
      "start": 7.708,
      "end": 11.153,
      "text": "Some called it critical. The superintendent disagreed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "File:Quebec bridge view No 48 (HS85-10-18817).jpg",
        "credit": "F. E. Cudworth",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Quebec_bridge_view_No_48_(HS85-10-18817).jpg",
        "path": "/root/episode/art/construction-span.jpg"
      },
      "shots": [
        {
          "start": 7.7,
          "end": 11.167,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.0,
            1.08,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 11.153,
      "end": 14.423,
      "text": "On August 29, the unfinished bridge collapsed.",
      "asset": {
        "source": "Wikimedia Commons",
        "title": "File:Pont de Quebec 1907.jpg",
        "credit": "Neurdein",
        "license": "Public domain",
        "url": "https://commons.wikimedia.org/wiki/File:Pont_de_Quebec_1907.jpg",
        "path": "/root/episode/art/collapse-1907.jpg"
      },
      "shots": [
        {
          "start": 11.167,
          "end": 14.433,
          "kind": "card",
          "motion": "camera",
          "camera_move": [
            1.08,
            1.0,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 14.423,
      "end": 18.818,
      "text": "A royal commission found the failed lower chords were defectively designed.",
      "asset": {
        "source": "Royal Commission report / authored graphic",
        "title": "authored graphic with facsimile crop of report printed page 9 finding (a)",
        "credit": "Royal Commission on the Quebec Bridge; editorial graphic",
        "license": "Public domain (1908 Royal Commission report); authored overlay",
        "url": "https://archive.org/download/reportandplansa01schngoog/reportandplansa01schngoog.pdf#page=16",
        "path": "/root/episode/art/report-design.png"
      },
      "shots": [
        {
          "start": 14.433,
          "end": 18.833,
          "kind": "cover",
          "motion": "depth",
          "camera_move": [
            1.04,
            1.04,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 18.818,
      "end": 22.963,
      "text": "It did not believe the bridge could be saved after August 27.",
      "asset": {
        "source": "Royal Commission report / authored graphic",
        "title": "authored graphic with facsimile crop of report printed page 9 findings (i) and (j)",
        "credit": "Royal Commission on the Quebec Bridge; editorial graphic",
        "license": "Public domain (1908 Royal Commission report); authored overlay",
        "url": "https://archive.org/download/reportandplansa01schngoog/reportandplansa01schngoog.pdf#page=16",
        "path": "/root/episode/art/report-judgment.png"
      },
      "shots": [
        {
          "start": 18.833,
          "end": 22.967,
          "kind": "cover",
          "motion": "depth",
          "camera_move": [
            1.04,
            1.04,
            0.5,
            0.5,
            0.5,
            0.5
          ]
        }
      ]
    },
    {
      "start": 22.963,
      "end": 26.618,
      "text": "But better judgment, it said, might have prevented the loss of life.",
