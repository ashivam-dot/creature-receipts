          ]
        }
      ]
    },
    {
      "start": 12.343,
      "end": 16.993,
      "text": "Instead, 50 tons of TNT detonated in the crowded factory.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 12.333,
          "end": 17.0,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
            1.0,
