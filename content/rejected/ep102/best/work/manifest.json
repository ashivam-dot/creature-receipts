            0.5
          ]
        }
      ]
    },
    {
      "start": 16.993,
      "end": 21.438,
      "text": "The government report into the 73 deaths stayed secret for decades.",
      "asset": {
        "source": "designed card"
      },
      "shots": [
        {
          "start": 17.0,
          "end": 21.433,
          "kind": "designed",
          "motion": "camera",
          "camera_move": [
