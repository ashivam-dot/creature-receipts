  "beats": [
    {
      "start": 0.15,
      "end": 3.992,
      "text": "Every second, the Sun destroys four million tons of itself.",
      "asset": {
        "source": "NASA Image and Video Library",
        "title": "NuSTAR Stares at the Sun",
        "credit": "NASA/JPL-Caltech/GSFC/JAXA",
        "url": "https://images.nasa.gov/details/PIA19821"
      }
    },
    {
      "start": 3.992,
      "end": 8.812,
      "text": "That missing mass becomes the light that reaches your eyes eight minutes later.",
      "asset": {
        "source": "NASA Image and Video Library",
        "title": "An orbital sunrise colorfully illuminates the Earth's atmosphere",
        "credit": "JSC",
        "url": "https://images.nasa.gov/details/iss071e439624"
      }
    },
    {
      "start": 8.812,
      "end": 13.032,
      "text": "And it has enough fuel to keep burning for another five billion years.",
      "asset": {
        "source": "NASA Image and Video Library",
        "title": "SDO Sees Solar Eclipse",
        "credit": "GSFC",
        "url": "https://images.nasa.gov/details/GSFC_20171208_Archive_e000010"
      }
    },
    {
      "start": 13.032,
      "end": 15.367,
      "text": "Follow for one space fact every day.",
      "asset": {
        "source": "generated gradient",
        "color": "#0B1D3A"
      }
    }
